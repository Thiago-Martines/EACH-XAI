<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Model Application</title>
    <link rel="stylesheet" type="text/css" href="stylesheets/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
</head>

<body>
    <div id="menu">
        <%- include('templates/top_menu.ejs') %>
    </div>

    <div id="container-geral" class="container_geral">
        <form id="wizardForm"
            style="height: 100%; max-height: 100%; width: 100%; max-width: 100%; display: flex; flex-direction: column;"
            enctype="multipart/form-data">
            <div class="step" id="step1" data-step="1" data-group="GeneralExplanation">
                <div class="step-title">Section General Explanation and Instructions</div>
                <div class="step-content">
                    <div class="content-wrapper">
                        <h4>This section is dedicated to optimizing the machine learning model, previously developed in
                            the other section, providing your feedback for its refinement.</h4>
                        <div style="max-width: 90%;">
                            <p>Start by uploading your model and the dataset used to train it, then choose between two
                                explanation methods: SHAP or LIME. In this section, you will be presented with random
                                instances from the dataset. For each instance, you will go through two steps:
                            </p>
                        </div>
                        <div style="max-width: 90%;">
                            <p>First, examine the feature values and make your own prediction for the target variable
                                based on the information provided and select the features you believe are most important
                                in supporting your decision. Then, the model's prediction for that same instance will be
                                revealed, along with the corresponding feature importance values generated by your
                                chosen explainer (SHAP or LIME). Based on this explanation, you will be asked to
                                indicate whether you agree or disagree with the model's prediction.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="step" id="step2" data-step="2" data-group="DatasetUpload">
                <div class="step-title">Model and Dataset Upload</div>
                <div class="step-content">
                    <div class="content-wrapper" style="min-height: 90%;">
                        <div style="display: flex; flex-direction: row; justify-content: space-evenly; width: 100%;">
                            <div id="uploadFormDataset" enctype="multipart/form-data">
                                <div>
                                    <div id="fakeFileInputDataset" style="align-content: center;">
                                        <span id="fakeFileSpanDataset"><b>Upload Dataset</b></span>
                                        <input type="file" id="fileInputDataset" name="uploadDataset" accept=".csv"
                                            style="display: none;">
                                    </div>
                                    <p id="datasetFileName" style="margin-top: 10px;">Dataset:</p>
                                    <button type="button" id="uploadButtonDataset">Upload Dataset</button>
                                    <p id="uploadStatusDataset"></p>
                                </div>
                            </div>
                            <div id="uploadFormModel" enctype="multipart/form-data">
                                <div>
                                    <div id="fakeFileInput" style="align-content: center;">
                                        <span id="fakeFileSpanModel"><b>Upload Model</b></span>
                                        <input type="file" id="fileInputModel" name="uploadModel" accept=".pkl"
                                            style="display: none;">
                                    </div>
                                    <p id="modelFileName" style="margin-top: 10px;">Model:</p>
                                    <button type="button" id="uploadButtonModel">Upload Model</button>
                                    <p id="uploadStatusModel"></p>
                                </div>
                            </div>
                        </div>
                        <div class="checkbox-group" style="margin-top: 1.5rem;">
                            <h4 class="checkbox-group-title">Explainers</h4>
                            <span class="checkbox-group-description">Choose which explainer to be used.</span>
                            <div class="checkbox-options">
                                <label class="checkbox-option" for="SHAP">
                                    <input type="checkbox" id="SHAP" class="checkbox-input explainer-checkbox"
                                        onchange="handleExclusiveCheckbox(this)">
                                    <span class="checkbox-custom"></span>
                                    <span class="checkbox-label">SHAP</span>
                                    <div class="tooltip-container option-tooltip">
                                        <span class="tooltip-icon">?</span>
                                        <span class="tooltip-text">SHAP (SHapley Additive exPlanations) uses game theory
                                            to calculate each feature's exact contribution to the final prediction. It
                                            provides mathematically consistent explanations where all feature
                                            contributions sum to the difference from baseline. Best for precise,
                                            comparable explanations across multiple instances.</span>
                                    </div>
                                </label>

                                <label class="checkbox-option" for="LIME">
                                    <input type="checkbox" id="LIME" class="checkbox-input explainer-checkbox"
                                        onchange="handleExclusiveCheckbox(this)">
                                    <span class="checkbox-custom"></span>
                                    <span class="checkbox-label">LIME</span>
                                    <div class="tooltip-container option-tooltip">
                                        <span class="tooltip-icon">?</span>
                                        <span class="tooltip-text">LIME (Local Interpretable Model-agnostic
                                            Explanations) explains individual predictions by creating simple,
                                            interpretable models around each instance. It shows which features
                                            influenced the prediction by testing small changes to feature values. Best
                                            for intuitive, easy-to-understand explanations of specific cases, though
                                            explanations may vary between similar instances.</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                        <script>
                            function handleExclusiveCheckbox(clickedCheckbox) {
                                const checkboxes = document.querySelectorAll('.explainer-checkbox');
                                checkboxes.forEach(checkbox => {
                                    if (checkbox !== clickedCheckbox) {
                                        checkbox.checked = false;
                                    }
                                });
                            }
                        </script>
                        <div id="error-message-step2" class="error-message" style="margin-top: 0.5rem;"></div>
                    </div>
                    <div id="loading-step2" class="loading-container" style="display: none;">
                        <div class="loading-spinner"></div>
                        <div class="loading-text">
                            <strong>Processing your files...</strong><br>
                            <span id="loading-explainer-text">Generating explanations and creating dynamic
                                instances</span>
                        </div>
                        <div class="loading-progress" id="loading-progress-step2">
                            This may take a few moments depending on your dataset size
                        </div>
                    </div>
                </div>
            </div>
            <div id="dynamic-instances-container" style="display: contents;"></div>
            <div class="step disabled" id="step_FineTuning" data-step="step_FineTuning" data-group="FineTuning">
                <div class="step-title">Fine Tuning Results</div>
                <div class="step-content">
                    <div class="content-wrapper">
                        <div class="fine-tuning-results">
                            <div class="reports-container"
                                style="display: flex; gap: 30px; justify-content: space-between;">
                                <div class="report-section">
                                    <h4 class="report-title">Original Model Performance</h4>
                                    <div id="original-classification-report"></div>
                                </div>

                                <div class="report-section">
                                    <h4 class="report-title optimized">Optimized Model Performance</h4>
                                    <div id="optimized-classification-report"></div>
                                </div>
                            </div>

                            <div class="improvement-summary" style="margin-top: 30px; text-align: center;">
                                <div class="improvement-card">
                                    <h5 style="margin: 0px">Model Optimization Summary</h5>
                                    <div class="key-improvements" id="key-improvements">
                                        <div class="improvement-item">
                                            <span class="metric-name">Accuracy</span>
                                            <span class="improvement-value" id="accuracy-improvement">+0.00%</span>
                                        </div>
                                        <div class="improvement-item">
                                            <span class="metric-name">Precision</span>
                                            <span class="improvement-value" id="precision-improvement">+0.00%</span>
                                        </div>
                                        <div class="improvement-item">
                                            <span class="metric-name">Recall</span>
                                            <span class="improvement-value" id="recall-improvement">+0.00%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="loading-fine-tuning" class="loading-container" style="display: none;">
                <div class="loading-spinner"></div>
                <div class="loading-text">
                    <strong>Optimizing Model...</strong><br>
                    Processing your feedback and adjusting model parameters
                </div>
                <div class="loading-progress" id="loading-progress-fine-tuning">
                    Analyzing user feedback and feature importance alignments
                </div>
            </div>

            <div id="navigation_content">
                <div class="navigation buttons">
                    <button type="button" id="prevBtn" onclick="prevStep()" disabled>Previous</button>
                    <button type="button" id="nextBtn" onclick="nextStep()">Next</button>
                </div>
            </div>
        </form>
    </div>
    <div class="footer">
        School of Arts, Sciences, and Humanities - University of São Paulo
    </div>
    <script>
        let datasetLoaded = false;
        let modelLoaded = false;
        let explanationsExecuted = false;
        let isProcessingExplanations = false;
        let isProcessingFineTuning = false;
        let selectedExplainer = null;
        let lastSelectedExplainer = null;

        // Variável global para armazenar feedback do usuário
        let userFeedback = {};

        // Função para mostrar/esconder o loading do step2
        function showLoadingStep2(show) {
            const loadingElement = document.getElementById('loading-step2');
            const contentWrapper = document.querySelector('#step2 .content-wrapper');

            if (show) {
                loadingElement.style.display = 'flex';
                contentWrapper.classList.add('loading-disabled');

                // Update loading text based on selected explainer
                const loadingExplainerText = document.getElementById('loading-explainer-text');
                if (selectedExplainer === 'SHAP') {
                    loadingExplainerText.textContent = 'Generating SHAP explanations and creating dynamic instances';
                } else if (selectedExplainer === 'LIME') {
                    loadingExplainerText.textContent = 'Generating LIME explanations and creating dynamic instances';
                }
            } else {
                loadingElement.style.display = 'none';
                contentWrapper.classList.remove('loading-disabled');

                // Atualizar navegação após carregar steps dinâmicos
                updateNavigationAfterDynamicLoad();
            }
        }

        // Função para mostrar/esconder o loading do step_FineTuning
        function showLoadingFineTuning(show) {
            const loadingElement = document.getElementById('loading-fine-tuning');
            const contentWrapper = document.querySelector('#step_FineTuning .content-wrapper');

            if (show) {
                loadingElement.style.display = 'flex';
                contentWrapper.classList.add('loading-disabled');
            } else {
                loadingElement.style.display = 'none';
                contentWrapper.classList.remove('loading-disabled');
            }
        }

        // Função para atualizar o progresso do loading do step2
        function updateLoadingProgress(message) {
            const progressElement = document.getElementById('loading-progress-step2');
            if (progressElement) {
                progressElement.textContent = message;
            }
        }

        // Função para atualizar o progresso do loading do step_FineTuning
        function updateFineTuningProgress(message) {
            const progressElement = document.getElementById('loading-progress-fine-tuning');
            if (progressElement) {
                progressElement.textContent = message;
            }
        }

        // Função para verificar qual explainer está selecionado
        function getSelectedExplainer() {
            const shapCheckbox = document.getElementById('SHAP');
            const limeCheckbox = document.getElementById('LIME');

            if (shapCheckbox.checked) return 'SHAP';
            if (limeCheckbox.checked) return 'LIME';
            return null;
        }

        // Função para executar as explicações baseado no explainer selecionado
        function executeExplanations() {
            selectedExplainer = getSelectedExplainer();

            if (!selectedExplainer) {
                console.error('Nenhum explainer selecionado');
                return;
            }

            // Verifica se o explainer mudou ou se nunca foi executado
            const explainerChanged = lastSelectedExplainer !== selectedExplainer;

            if (!explainerChanged && explanationsExecuted) {
                console.log('Explainer não mudou e já foi executado, pulando execução');
                return;
            }

            console.log(`Executando explicações com ${selectedExplainer}...`);

            // Se o explainer mudou, reseta o estado
            if (explainerChanged) {
                explanationsExecuted = false;
                const container = document.getElementById('dynamic-instances-container');
                container.innerHTML = '';
                totalInstances = 0;
                instanceSelections = {};

                const fineTuningStep = document.getElementById('step_FineTuning');
                fineTuningStep.classList.add('disabled');
            }

            explanationsExecuted = true;
            isProcessingExplanations = true;
            lastSelectedExplainer = selectedExplainer;

            // Mostra o loading
            showLoadingStep2(true);
            updateLoadingProgress(`Initializing ${selectedExplainer} analysis...`);

            if (selectedExplainer === 'SHAP') {
                shapEXP();
            } else if (selectedExplainer === 'LIME') {
                limeEXP();
            }
        }

        // Requisição inicial para buscar o nome do arquivo e número de variáveis ao carregar a página
        window.addEventListener('DOMContentLoaded', () => {
            fetch('/datasetFileName')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('No dataset selected');
                    }
                    return response.json();
                })
                .then(data => {
                    document.getElementById('datasetFileName').innerText = 'Dataset: ' + data.fileName;
                    datasetLoaded = true;

                })
                .catch(error => {
                    console.error('Error loading dataset:', error);
                    document.getElementById('datasetFileName').innerText = 'No dataset selected';
                    datasetLoaded = false;

                });
        });

        window.addEventListener('DOMContentLoaded', () => {
            fetch('/modelFileName')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('No model selected');
                    }
                    return response.json();
                })
                .then(data => {
                    document.getElementById('modelFileName').innerText = 'Model: ' + data.fileName;
                    modelLoaded = true;

                })
                .catch(error => {
                    console.error('Error loading model:', error);
                    document.getElementById('modelFileName').innerText = 'No model selected';
                    modelLoaded = false;

                });
        });

        // Dataset Upload
        const fakeFileInputDataset = document.getElementById('fakeFileInputDataset');
        const fileInputDataset = document.getElementById('fileInputDataset');
        const uploadButtonDataset = document.getElementById('uploadButtonDataset');

        fakeFileInputDataset.addEventListener('click', () => {
            fileInputDataset.click();
        });

        fileInputDataset.addEventListener('change', () => {
            if (fileInputDataset.files.length > 0) {
                uploadButtonDataset.click();
            }
        });

        uploadButtonDataset.addEventListener('click', function (event) {
            event.preventDefault();
            if (!fileInputDataset.files[0]) {
                alert('Please select a dataset file first.');
                return;
            }

            var formDataDataset = new FormData();
            formDataDataset.append('uploadDataset', fileInputDataset.files[0]);

            document.getElementById('uploadStatusDataset').textContent = 'Upload in progress...';

            fetch('/uploadDataset', {
                method: 'POST',
                body: formDataDataset
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    document.getElementById('uploadStatusDataset').textContent = '';
                    return fetch('/datasetFileName');
                })
                .then(response => response.json())
                .then(data => {
                    console.log(data);
                    document.getElementById('datasetFileName').innerText = 'Dataset: ' + data.fileName;
                    document.getElementById('uploadStatusDataset').textContent = '';
                    datasetLoaded = true;

                })
                .catch(error => {
                    console.error('There was a problem with the dataset upload:', error);
                    document.getElementById('uploadStatusDataset').textContent = 'Upload failed. Please try again';
                    document.getElementById('datasetFileName').textContent = 'No dataset selected';
                    datasetLoaded = false;

                });
        });

        // Model Upload
        const fakeFileInputModel = document.getElementById('fakeFileInput');
        const fileInputModel = document.getElementById('fileInputModel');
        const uploadButtonModel = document.getElementById('uploadButtonModel');

        fakeFileInputModel.addEventListener('click', () => {
            fileInputModel.click();
        });

        fileInputModel.addEventListener('change', () => {
            if (fileInputModel.files.length > 0) {
                uploadButtonModel.click();
            }
        });

        uploadButtonModel.addEventListener('click', function (event) {
            event.preventDefault();

            if (!fileInputModel.files[0]) {
                alert('Please select a model file first.');
                return;
            }

            var formDataModel = new FormData();
            formDataModel.append('uploadModel', fileInputModel.files[0]);

            document.getElementById('uploadStatusModel').textContent = 'Upload in progress...';

            fetch('/uploadModel', {
                method: 'POST',
                body: formDataModel
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    document.getElementById('uploadStatusModel').textContent = '';
                    return fetch('/modelFileName');
                })
                .then(response => response.json())
                .then(data => {
                    console.log(data);
                    document.getElementById('modelFileName').innerText = 'Model: ' + data.fileName;
                    document.getElementById('uploadStatusModel').textContent = '';
                    modelLoaded = true;

                })
                .catch(error => {
                    console.error('There was a problem with the model upload:', error);
                    document.getElementById('uploadStatusModel').textContent = 'Upload failed. Please try again';
                    document.getElementById('modelFileName').textContent = 'No model selected';
                    modelLoaded = false;

                });
        });

        function validateStep2Live() {
            const datasetName = document.getElementById('datasetFileName');
            const modelName = document.getElementById('modelFileName')
            const errorMessageStep2 = document.getElementById('error-message-step2');
            const selectedExplainer = getSelectedExplainer();

            if (datasetName.innerText === "No dataset selected" || modelName.innerText === "No model selected") {
                errorMessageStep2.style.display = 'block';
                errorMessageStep2.innerText = "Select your dataset and model";
            } else if (!selectedExplainer) {
                errorMessageStep2.style.display = 'block';
                errorMessageStep2.innerText = "Select an explainer (SHAP or LIME)";
            } else {
                errorMessageStep2.style.display = 'none';
                errorMessageStep2.innerText = "";
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const explainerCheckboxes = document.querySelectorAll('.explainer-checkbox');
            explainerCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', validateStep2Live);
            });
        });

        function shapEXP() {
            console.log('Iniciando explicação SHAP...');
            updateLoadingProgress('Calculating SHAP values for dataset instances...');

            fetch('/shapEXP', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Erro na requisição SHAP');
                    }
                    updateLoadingProgress('Processing SHAP results and generating interface...');
                    return response.json();
                })
                .then(data => {
                    console.log('Resultados SHAP recebidos:');
                    console.log(data);

                    updateLoadingProgress('Creating dynamic instances...');

                    setTimeout(() => {
                        onExplanationDataReceived(data);
                        updateContainerStyle();
                        enableFineTuningStep();
                        updateLoadingProgress('Complete! Ready to proceed.');
                        setTimeout(() => {
                            showLoadingStep2(false);
                            isProcessingExplanations = false;
                            const enabledSteps = getEnabledSteps();
                            if (currentStep < enabledSteps.length - 1) {
                                currentStep++;
                                showStep(currentStep);
                            }
                        }, 500);

                    }, 500);
                })
                .catch(error => {
                    console.error('Erro ao obter explicações SHAP:', error);
                    handleExplanationError();
                });
        }

        function limeEXP() {
            console.log('Iniciando explicação LIME...');
            updateLoadingProgress('Calculating LIME explanations for dataset instances...');

            fetch('/limeEXP', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Erro na requisição LIME');
                    }
                    updateLoadingProgress('Processing LIME results and generating interface...');
                    return response.json();
                })
                .then(data => {
                    console.log('Resultados LIME recebidos:');
                    console.log(data);

                    updateLoadingProgress('Creating dynamic instances...');
                    setTimeout(() => {
                        onExplanationDataReceived(data);
                        updateContainerStyle();
                        enableFineTuningStep();
                        updateLoadingProgress('Complete! Ready to proceed.');
                        setTimeout(() => {
                            showLoadingStep2(false);
                            isProcessingExplanations = false;
                            const enabledSteps = getEnabledSteps();
                            if (currentStep < enabledSteps.length - 1) {
                                currentStep++;
                                showStep(currentStep);
                            }
                        }, 500);

                    }, 500);
                })
                .catch(error => {
                    console.error('Erro ao obter explicações LIME:', error);
                    handleExplanationError();
                });
        }

        function handleExplanationError() {
            // Em caso de erro, esconde o loading e mostra erro
            showLoadingStep2(false);
            isProcessingExplanations = false;
            explanationsExecuted = false;

            const errorMessageStep2 = document.getElementById('error-message-step2');
            errorMessageStep2.style.display = 'block';
            errorMessageStep2.innerText = 'Error processing files. Please try uploading again.';
        }

        // Função para habilitar o step_FineTuning
        function enableFineTuningStep() {
            const fineTuningStep = document.getElementById('step_FineTuning');
            fineTuningStep.classList.remove('disabled');
            console.log('Fine Tuning step enabled');
        }

        // Função para coletar feedback do usuário
        function collectUserFeedback() {
            userFeedback = {};

            for (let i = 1; i <= totalInstances; i++) {
                // Coletar classe predita pelo usuário
                const selectedClassButton = document.querySelector(`#class-buttons-${i} .class-button.selected`);
                const userPredictedClass = selectedClassButton ? selectedClassButton.getAttribute('data-class') : null;

                // Coletar features selecionadas pelo usuário
                const selectedFeatures = Object.keys(instanceSelections[i]?.selectedFeatures || {});

                // Coletar concordância com a predição do modelo
                const agreementButton = document.querySelector(`#agreement-buttons-${i} .agreement-button.selected`);
                const modelAgreement = agreementButton ? agreementButton.getAttribute('data-value') : null;

                userFeedback[`instance_${i}`] = {
                    model_prediction: explanationData.predictions[`sample_${i}`],
                    explanation: selectedExplainer === 'SHAP' ?
                        explanationData.shap_explanations[`sample_${i}`] :
                        explanationData.lime_explanations[`sample_${i}`],
                    user_predicted_class: userPredictedClass,
                    user_selected_features: selectedFeatures,
                    user_model_agreement: modelAgreement
                };
            }

            console.log('User Feedback Collected:');
            console.log(JSON.stringify(userFeedback, null, 2));

            return userFeedback;
        }

        // Função para gerar HTML do relatório de classificação
        function generateClassificationReportHTML(report) {
            const classRows = [];
            const generalRows = [];

            // Separar classes das métricas gerais
            const classes = [];
            const metrics = ['micro avg', 'macro avg', 'weighted avg', 'accuracy'];
            const generalMetrics = [];

            for (const [key, value] of Object.entries(report)) {
                if (!metrics.includes(key) && typeof value === 'object' && value !== null) {
                    classes.push([key, value]);
                } else if (metrics.includes(key)) {
                    generalMetrics.push([key, value]);
                }
            }

            // Gerar linhas das classes
            classes.forEach(([className, metrics]) => {
                classRows.push(`
        <tr class="class-row">
            <td class="class-name">${formatClassName(className)}</td>
            <td class="metric-value">${(metrics.precision * 100).toFixed(2)}%</td>
            <td class="metric-value">${(metrics.recall * 100).toFixed(2)}%</td>
            <td class="metric-value">${(metrics['f1-score'] * 100).toFixed(2)}%</td>
            <td class="metric-value">${metrics.support}</td>
        </tr>
    `);
            });

            // Gerar linhas das métricas gerais
            generalMetrics.forEach(([metricName, value]) => {
                const rowClass = metricName === 'accuracy' ? 'accuracy-row' : 'avg-row';

                if (metricName === 'accuracy') {
                    const accuracyValue = (value * 100).toFixed(2);
                    generalRows.push(`
            <tr class="${rowClass}">
                <td class="general-metric-name">${formatClassName(metricName)}</td>
                <td class="metric-value">-</td>
                <td class="metric-value">-</td>
                <td class="metric-value">${accuracyValue}%</td>
                <td class="metric-value">-</td>
            </tr>
        `);
                } else {
                    const precision = typeof value === 'object' && value.precision ?
                        (value.precision * 100).toFixed(2) + '%' : '-';
                    const recall = typeof value === 'object' && value.recall ?
                        (value.recall * 100).toFixed(2) + '%' : '-';
                    const f1Score = typeof value === 'object' && value['f1-score'] ?
                        (value['f1-score'] * 100).toFixed(2) + '%' : '-';
                    const support = typeof value === 'object' && value.support ?
                        value.support : '-';

                    generalRows.push(`
            <tr class="${rowClass}">
                <td class="general-metric-name">${formatClassName(metricName)}</td>
                <td class="metric-value">${precision}</td>
                <td class="metric-value">${recall}</td>
                <td class="metric-value">${f1Score}</td>
                <td class="metric-value">${support}</td>
            </tr>
        `);
                }
            });

            return `
    <table class="report-table">
        <thead>
            <tr>
                <th>Class</th>
                <th>Precision</th>
                <th>Recall</th>
                <th>F1-Score</th>
                <th>Support</th>
            </tr>
        </thead>
        <tbody>
            ${classRows.join('')}
            ${generalRows.length > 0 ? '<tr class="separator-row"><td colspan="5"></td></tr>' : ''}
            ${generalRows.join('')}
        </tbody>
    </table>
`;
        }

        // Função para formatar nomes de classes
        function formatClassName(className) {
            return className
                .replace(/_/g, ' ')
                .replace(/([A-Z])/g, ' $1')
                .replace(/\b\w/g, l => l.toUpperCase())
                .trim();
        }

        // Função para simular melhorias no modelo
        function simulateOptimizedReport(originalReport) {
            const optimizedReport = JSON.parse(JSON.stringify(originalReport));

            // Aplicar melhorias simuladas
            const improvementFactor = 0.03 + Math.random() * 0.07;

            for (const [key, value] of Object.entries(optimizedReport)) {
                if (typeof value === 'object' && value !== null && key !== 'accuracy') {
                    if (value.precision) value.precision = Math.min(1, value.precision * (1 + improvementFactor));
                    if (value.recall) value.recall = Math.min(1, value.recall * (1 + improvementFactor));
                    if (value['f1-score']) value['f1-score'] = Math.min(1, value['f1-score'] * (1 + improvementFactor));
                } else if (key === 'accuracy') {
                    optimizedReport[key] = Math.min(1, value * (1 + improvementFactor));
                }
            }

            return optimizedReport;
        }

        // Função para calcular melhorias
        function calculateImprovements(original, optimized) {
            const originalAccuracy = original.accuracy * 100;
            const optimizedAccuracy = optimized.accuracy * 100;
            const accuracyImprovement = optimizedAccuracy - originalAccuracy;

            const originalPrecision = original['weighted avg'].precision * 100;
            const optimizedPrecision = optimized['weighted avg'].precision * 100;
            const precisionImprovement = optimizedPrecision - originalPrecision;

            const originalRecall = original['weighted avg'].recall * 100;
            const optimizedRecall = optimized['weighted avg'].recall * 100;
            const recallImprovement = optimizedRecall - originalRecall;

            return {
                accuracy: accuracyImprovement,
                precision: precisionImprovement,
                recall: recallImprovement
            };
        }

        // Função para processar o Fine Tuning
        function processFineTuning() {
            if (isProcessingFineTuning) return;

            // Coletar feedback do usuário antes de processar
            collectUserFeedback();

            isProcessingFineTuning = true;
            showLoadingFineTuning(true);

            // Simular o processamento
            const steps = [
                {message: 'Analyzing user feedback and feature importance alignments', delay: 2000},
                {message: 'Calculating model parameter adjustments', delay: 2000},
                {message: 'Applying optimization algorithms', delay: 2000},
                {message: 'Validating model improvements', delay: 2000},
                {message: 'Finalizing optimized model', delay: 2000}
            ];

            let currentStepIndex = 0;

            function processNextStep() {
                if (currentStepIndex < steps.length) {
                    updateFineTuningProgress(steps[currentStepIndex].message);
                    setTimeout(() => {
                        currentStepIndex++;
                        processNextStep();
                    }, steps[currentStepIndex].delay);
                } else {
                    // Gerar relatórios
                    const originalReport = explanationData.metadata.classification_report;
                    const optimizedReport = simulateOptimizedReport(originalReport);

                    // Calcular melhorias
                    const improvements = calculateImprovements(originalReport, optimizedReport);

                    // Gerar HTML dos relatórios
                    document.getElementById('original-classification-report').innerHTML =
                        generateClassificationReportHTML(originalReport);
                    document.getElementById('optimized-classification-report').innerHTML =
                        generateClassificationReportHTML(optimizedReport);

                    // Atualizar resumo das melhorias
                    document.getElementById('accuracy-improvement').textContent =
                        `+${improvements.accuracy.toFixed(2)}%`;
                    document.getElementById('precision-improvement').textContent =
                        `+${improvements.precision.toFixed(2)}%`;
                    document.getElementById('recall-improvement').textContent =
                        `+${improvements.recall.toFixed(2)}%`;

                    const navigation = document.getElementById('navigation_content');
                    updateFineTuningProgress('Optimization complete!');
                    setTimeout(() => {
                        showLoadingFineTuning(false);
                        isProcessingFineTuning = false;
                        navigation.style.display = 'none';

                        // Navega para o step_FineTuning
                        const enabledSteps = getEnabledSteps();
                        currentStep = enabledSteps.length - 1;
                        showStep(currentStep);
                    }, 1000);
                }
            }

            processNextStep();
        }
    </script>
    <script>
        let explanationData = null;
        let totalInstances = 0;
        let instanceSelections = {}

        function onExplanationDataReceived(data) {
            console.log('Explanation data received, generating dynamic instances...');
            explanationData = data;
            generateDynamicInstances(data);
        }

        function generateDynamicInstances(data) {
            const container = document.getElementById('dynamic-instances-container');
            container.innerHTML = '';

            // Determina o número de instâncias baseado nos dados
            totalInstances = data.metadata.n_samples_analyzed ||
                Object.keys(data.shap_explanations || data.lime_explanations).length;

            // Gera steps para cada instância
            for (let i = 1; i <= totalInstances; i++) {
                // Step de predição do usuário
                const userPredictionStep = createUserPredictionStep(i, data);
                container.appendChild(userPredictionStep);

                // Step de predição do modelo
                const modelPredictionStep = createModelPredictionStep(i, data);
                container.appendChild(modelPredictionStep);
            }

            console.log(`Generated ${totalInstances * 2} dynamic steps`);
        }

        function createUserPredictionStep(instanceNum, data) {
            const stepElement = document.createElement('div');
            stepElement.className = 'step';
            stepElement.id = `step${2 + (instanceNum - 1) * 2 + 1}`;
            stepElement.setAttribute('data-step', 2 + (instanceNum - 1) * 2 + 1);
            stepElement.setAttribute('data-group', `Instance${instanceNum}`);

            stepElement.innerHTML = `
                <div class="step-title">Instance <b class="emphasis">${instanceNum}/${totalInstances}</b> - Your Prediction</div>
                <p style="max-width:50%; align-self: center;">In this step, you should review the feature values for instance (<b class="emphasis">${instanceNum}</b>) shown on the left side and use them to <b class="emphasis">predict the target class</b>. Additionally, based on your decision-making process, <b class="emphasis">select the most important features</b> that guided your prediction.</p>
                <div class="step-content">
                    <div class="content-wrapper" style="flex-direction: row; justify-content: space-evenly;">
                        <div style="flex-direction: column; width: 60%;">
                            <div><b>Instance Feature Values:</b></div>
                            <div class="instance-values scrollable-box">
                                <ul id="feature-values-display-${instanceNum}" class="feature-list"></ul>
                            </div>    
                            <div id="error-message-step${2 + (instanceNum - 1) * 2 + 1}" class="error-message"></div>
                        </div>
                        <div class="filters-container" style="margin-bottom: 25px; flex-direction: column; min-width: 10%;">
                            <div class="filter-group" style="align-items: center;">
                                <p>Predict which <b class="emphasis">target class</b> this instance belong to:</p>
                                <div id="class-buttons-${instanceNum}" class="class-buttons"></div>
                            </div>
                            <div class="filter-group">
                                <p>Select which features were <b class="emphasis">important</b> for your prediction:</p>
                                <div class="search-filter" style="width: 80%;">
                                    <input type="text" id="search-features-${instanceNum}" placeholder="Type to search..."
                                        onkeyup="filterOptionsForInstance(${instanceNum}, 'features')">
                                    <div id="checkbox-list-features-${instanceNum}" class="checkbox-list"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Inicializa as seleções para esta instância
            instanceSelections[instanceNum] = {
                selectedClass: {},
                selectedFeatures: {}
            };

            return stepElement;
        }

        function createModelPredictionStep(instanceNum, data) {
            const stepElement = document.createElement('div');
            stepElement.className = 'step';
            stepElement.id = `step${2 + (instanceNum - 1) * 2 + 2}`;
            stepElement.setAttribute('data-step', 2 + (instanceNum - 1) * 2 + 2);
            stepElement.setAttribute('data-group', `Instance${instanceNum}`);

            const explanationTitle = selectedExplainer === 'SHAP' ? 'SHAP Feature Importances' : 'LIME Feature Importances';
            const explanationText = selectedExplainer === 'SHAP' ?
                'The waterfall chart shows how each feature contributed to the model\'s decision. Starting from the baseline value E[f(X)] (the average prediction across all training data), each bar represents how a specific feature value pushed the prediction higher (orange bars) or lower (blue bars) compared to this baseline.' :
                'The horizontal bar chart shows how each feature contributed to the model\'s prediction. Positive values (orange bars) increase the likelihood of the predicted class, while negative values (blue bars) decrease it. The length of each bar represents the strength of the feature\'s influence.';

            stepElement.innerHTML = `
                <div class="step-title">Instance <b class="emphasis">${instanceNum}/${totalInstances}</b> - Model Prediction</div>
                <div class="step-content">
                    <div class="content-wrapper" style="flex-direction: row;">
                        <div class="explanation-container" style="min-width: 60%;">
                            <div class="explanation-title">${explanationTitle}</div>
                            <div id="explanation-chart-${instanceNum}"></div>
                        </div>
                        <div class="content-wrapper" style="max-height: 100%;">
                            <div class="prediction-info">
                                <div class="prediction-explanation">
                                    <div class="explanation-text" style="font-size: 14px; line-height: 1.6; color: #555; margin-bottom: 15px;">
                                        <p>${explanationText}</p>
                                        <p>Features with larger bars (positive or negative) had more influence on the final prediction.</p>
                                    </div>
                                    <div class="final-prediction">
                                        <div style="font-size: 14px; color: #666; margin-bottom: 5px;">Based on this analysis, the model predicted that this instance belongs to class:</div>
                                        <div id="prediction-display-${instanceNum}" class="prediction-class">Loading...</div>
                                    </div>
                                </div>
                            </div>
                            <div class="checkbox-group">
                                <h4 class="checkbox-group-title">Do you agree with the model's prediction?</h4>
                                <div id="agreement-buttons-${instanceNum}" class="agreement-buttons">
                                    <button type="button" class="agreement-button" data-value="agree" data-instance="${instanceNum}">
                                        Yes, I agree with this prediction
                                    </button>
                                    <button type="button" class="agreement-button disagree" data-value="disagree" data-instance="${instanceNum}">
                                        No, I disagree with this prediction
                                    </button>
                                </div>
                            </div>
                            <div id="error-message-step${2 + (instanceNum - 1) * 2 + 2}" class="error-message"></div>
                        </div>
                    </div>
                    <div class="tooltip-explanation" id="tooltip-${instanceNum}"></div>
                </div>
            `;

            return stepElement;
        }

        function createClassButtons(instanceNum) {
            const container = document.getElementById(`class-buttons-${instanceNum}`);
            const classNames = explanationData.metadata.class_names || [];

            container.innerHTML = '';

            classNames.forEach(className => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'class-button';
                button.textContent = className;
                button.setAttribute('data-class', className);
                button.setAttribute('data-instance', instanceNum);

                button.addEventListener('click', function () {
                    container.querySelectorAll('.class-button').forEach(btn => {
                        btn.classList.remove('selected');
                    });
                    this.classList.add('selected');

                    instanceSelections[instanceNum].selectedClass = {};
                    instanceSelections[instanceNum].selectedClass[className] = true;

                    validateSelectionUser(instanceNum, "filter")
                });

                container.appendChild(button);
            });
        }

        function filterOptionsForInstance(instanceNum, type) {
            if (type === 'class') {
                createClassButtons(instanceNum);
                return;
            }

            const searchValue = document.getElementById(`search-${type}-${instanceNum}`).value.toLowerCase();
            const checkboxList = document.getElementById(`checkbox-list-${type}-${instanceNum}`);
            checkboxList.innerHTML = '';

            const options = explanationData.metadata.selected_features || [];
            const selectedGroup = instanceSelections[instanceNum].selectedFeatures;

            const filteredOptions = options.filter(option =>
                option.toLowerCase().includes(searchValue)
            );

            filteredOptions.forEach(option => {
                const checkboxContainer = document.createElement('label');
                checkboxContainer.className = 'checkbox-option';
                const checkboxId = `checkbox-${type}-${instanceNum}-${option.replace(/\s+/g, '-')}`;
                const isChecked = selectedGroup[option] || false;

                checkboxContainer.innerHTML = `
                    <input type="checkbox" id="${checkboxId}" class="checkbox-input" 
                        value="${option}" ${isChecked ? 'checked' : ''}>
                    <span class="checkbox-custom"></span>
                    <span class="checkbox-label">${option}</span>
                `;

                const inputElement = checkboxContainer.querySelector('input');
                inputElement.addEventListener('change', function () {
                    updateSelectionForInstance(instanceNum, this, type);
                    validateSelectionUser(instanceNum, "filter")
                });

                checkboxList.appendChild(checkboxContainer);
            });
        }

        function updateSelectionForInstance(instanceNum, checkbox, type) {
            if (type === 'features') {
                if (checkbox.checked) {
                    instanceSelections[instanceNum].selectedFeatures[checkbox.value] = true;
                } else {
                    delete instanceSelections[instanceNum].selectedFeatures[checkbox.value];
                }
            }
        }

        function validateSelectionUser(instanceNum, type) {
            const errorMessage = document.getElementById(`error-message-step${2 + (instanceNum - 1) * 2 + 1}`);
            const classSelected = Object.keys(instanceSelections[instanceNum].selectedClass).length > 0;
            const featuresSelected = Object.keys(instanceSelections[instanceNum].selectedFeatures).length > 0;
            if (type == "filter" && errorMessage.innerText == "") {
                return
            }
            if (!classSelected && !featuresSelected) {
                errorMessage.style.display = 'block';
                errorMessage.innerText = "Predict the target class and at least one feature you deem important.";
            } else if (!classSelected) {
                errorMessage.style.display = 'block';
                errorMessage.innerText = "Predict a target class";
            } else if (!featuresSelected) {
                errorMessage.style.display = 'block';
                errorMessage.innerText = "Select at least one feature you deem important.";
            } else {
                errorMessage.style.display = 'none';
                errorMessage.innerText = "";
            }
        }

        function validateSelectionModel(instanceNum) {
            const errorMessage = document.getElementById(`error-message-step${2 + (instanceNum - 1) * 2 + 2}`);
            const buttons = document.querySelectorAll(`#agreement-buttons-${instanceNum} .agreement-button`);
            const selectedButton = document.querySelector(`#agreement-buttons-${instanceNum} .agreement-button.selected`);

            if (!selectedButton) {
                errorMessage.style.display = 'block';
                errorMessage.innerText = "Select if you agree or disagree with the model's predictions.";
            } else {
                errorMessage.style.display = 'none';
                errorMessage.innerText = "";
            }
        }

        // Adiciona event listeners após criar os elementos
        function addInstanceEventListeners() {
            for (let i = 1; i <= totalInstances; i++) {
                const agreementButtons = document.querySelectorAll(`#agreement-buttons-${i} .agreement-button`);

                agreementButtons.forEach(button => {
                    button.addEventListener('click', function () {
                        const instanceNum = parseInt(this.getAttribute('data-instance'));
                        const container = document.getElementById(`agreement-buttons-${instanceNum}`);

                        container.querySelectorAll('.agreement-button').forEach(btn => {
                            btn.classList.remove('selected');
                        });
                        this.classList.add('selected');

                        validateSelectionModel(instanceNum);
                    });
                });

                // Inicializa os filtros e valores das features
                displayInstanceValues(i);
                if (explanationData) {
                    createClassButtons(i);
                    filterOptionsForInstance(i, 'features');
                    displayModelPrediction(i);
                    createExplanationChart(i);
                }
            }
        }

        function displayInstanceValues(instanceNum) {
            const featureValuesDisplay = document.getElementById(`feature-values-display-${instanceNum}`);

            if (!explanationData) {
                featureValuesDisplay.innerHTML = '<p>Loading instance values...</p>';
                return;
            }

            const explanations = selectedExplainer === 'SHAP' ?
                explanationData.shap_explanations : explanationData.lime_explanations;
            const sampleData = explanations[`sample_${instanceNum}`];

            if (sampleData) {
                let featuresHTML;

                if (selectedExplainer === 'LIME') {
                    // Para LIME, extrair o valor da feature da chave (ex: "insulin = 45.0000")
                    featuresHTML = Object.keys(sampleData).map(featureKey => {
                        return `<li class="feature-value">${featureKey}</li>`;
                    }).join('');
                } else {
                    // Para SHAP, manter comportamento original
                    featuresHTML = Object.keys(sampleData).map(featureValue => {
                        return `<li class="feature-value">${featureValue}</li>`;
                    }).join('');
                }

                featureValuesDisplay.innerHTML = featuresHTML;
            } else {
                featureValuesDisplay.innerHTML = '<p>No data available for this instance</p>';
            }
        }

        function displayModelPrediction(instanceNum) {
            const predictionDisplay = document.getElementById(`prediction-display-${instanceNum}`);

            if (!explanationData) {
                predictionDisplay.textContent = 'Loading...';
                return;
            }

            const predictionData = explanationData.predictions[`sample_${instanceNum}`];

            if (predictionData) {
                const predictedClass = predictionData.predicted_class_name;
                predictionDisplay.textContent = predictedClass;
                predictionDisplay.className = 'prediction-class';

                // Adicionar cor baseada na classe
                if (predictedClass.includes('negative')) {
                    predictionDisplay.style.backgroundColor = '#008c9e';
                } else if (predictedClass.includes('positive')) {
                    predictionDisplay.style.backgroundColor = '#f4a840';
                }
            } else {
                predictionDisplay.textContent = 'No prediction available';
            }
        }

        function createExplanationChart(instanceNum) {
            if (selectedExplainer === 'SHAP') {
                createWaterfallChart(instanceNum);
            } else if (selectedExplainer === 'LIME') {
                createLimeChart(instanceNum);
            }
        }

        function createLimeChart(instanceNum) {
            const container = document.getElementById(`explanation-chart-${instanceNum}`);
            container.innerHTML = '';

            if (!explanationData) return;

            const limeValues = explanationData.lime_explanations[`sample_${instanceNum}`];
            const predictionData = explanationData.predictions[`sample_${instanceNum}`];

            if (!limeValues) return;

            // Container para o chart
            const chartContainer = document.createElement('div');

            // Container para probabilities
            const probContainer = document.createElement('div');
            probContainer.style.display = 'flex';
            probContainer.style.flexDirection = 'column';

            const features = Object.keys(limeValues);
            const values = Object.values(limeValues);

            const chartData = Object.entries(limeValues).map(([featureKey, limeData]) => {
                const featureName = featureKey.split(' = ')[0];
                const featureValue = featureKey.split(' = ')[1];

                return {
                    feature: featureName,
                    value: featureValue,
                    importance: limeData.lime_value,
                    description: limeData.lime_description,
                    isPositive: limeData.lime_value > 0
                };
            })
                .sort((a, b) => Math.abs(b.importance) - Math.abs(a.importance));

            if (chartData.length === 0) {
                container.innerHTML = '<p>No LIME explanation data available for this sample.</p>';
                return;
            }

            // Dimensões
            const margin = {top: 20, right: 120, bottom: 60, left: 240};
            const width = 800 - margin.left - margin.right;
            const height = 400 - margin.top - margin.bottom;

            const svg = d3.select(chartContainer)
                .append('svg')
                .attr('width', width + margin.left + margin.right)
                .attr('height', height + margin.top + margin.bottom)
                .attr('class', 'lime-chart');

            const g = svg.append('g')
                .attr('transform', `translate(${margin.left},${margin.top})`);

            const yScale = d3.scaleBand()
                .range([0, height])
                .domain(chartData.map(d => d.feature))
                .padding(0.2);

            const maxAbsValue = d3.max(chartData, d => Math.abs(d.importance));
            const xScale = d3.scaleLinear()
                .range([0, width])
                .domain([-maxAbsValue * 1.1, maxAbsValue * 1.1])
                .nice();

            // Tooltip
            const tooltip = d3.select(`#tooltip-${instanceNum}`);

            // Linha 0 de referência
            g.append('line')
                .attr('class', 'zero-line')
                .attr('x1', xScale(0))
                .attr('x2', xScale(0))
                .attr('y1', 0)
                .attr('y2', height)
                .attr('stroke', '#999')
                .attr('stroke-width', 2);

            // Feature bars
            g.selectAll('.lime-bar')
                .data(chartData)
                .enter()
                .append('rect')
                .attr('class', 'lime-bar')
                .attr('y', d => yScale(d.feature))
                .attr('height', yScale.bandwidth())
                .attr('x', d => d.importance >= 0 ? xScale(0) : xScale(d.importance))
                .attr('width', d => Math.abs(xScale(d.importance) - xScale(0)))
                .attr('fill', d => d.isPositive ? '#f4a840' : '#008c9e')
                .attr('stroke', '#fff')
                .attr('stroke-width', 1)
                .on('mouseover', function (event, d) {
                    const rect = this.getBoundingClientRect();
                    tooltip.style('opacity', 1)
                        .style('visibility', 'visible')
                        .html(`
            <strong>${d.feature}</strong><br/>
            Value: ${d.value}<br/>
            Description: ${d.description}<br/>
            Importance: ${d.importance.toFixed(4)}<br/>
            Impact: ${d.isPositive ? 'Positive' : 'Negative'}
        `)
                        .style('position', 'fixed')
                        .style('left', `${rect.right + 20}px`)
                        .style('top', `${rect.top + window.scrollY - 8}px`);
                })
                .on('mouseout', function () {
                    tooltip.style('opacity', 0)
                })

            // Função para determinar se o label do valor cabe na feature bar
            function labelFitsInBar(d) {
                const barWidth = Math.abs(xScale(d.importance) - xScale(0));
                const labelText = d.importance.toFixed(3);
                const estimatedTextWidth = labelText.length * 6;
                return barWidth > estimatedTextWidth + 10;
            }

            // Label dinâmico dos valores das featuer bars
            g.selectAll('.bar-label')
                .data(chartData)
                .enter()
                .append('text')
                .attr('class', 'bar-label')
                .attr('y', d => yScale(d.feature) + yScale.bandwidth() / 2)
                .attr('x', d => {
                    const fitsInside = labelFitsInBar(d);

                    if (fitsInside) {
                        const barStart = d.importance >= 0 ? xScale(0) : xScale(d.importance);
                        const barEnd = d.importance >= 0 ? xScale(d.importance) : xScale(0);
                        return (barStart + barEnd) / 2;
                    } else {
                        if (d.importance >= 0) {
                            return xScale(d.importance) + 5;
                        } else {
                            return xScale(d.importance) - 5;
                        }
                    }
                })
                .attr('dy', '0.35em')
                .attr('text-anchor', d => {
                    const fitsInside = labelFitsInBar(d);

                    if (fitsInside) {
                        return 'middle';
                    } else {
                        if (d.importance >= 0) {
                            return 'start';
                        } else {
                            return 'end';
                        }
                    }
                })
                .style('font-size', '11px')
                .style('font-weight', 'bold')
                .style('fill', d => {
                    const fitsInside = labelFitsInBar(d);

                    if (fitsInside) {
                        return 'white';
                    } else {
                        return d.importance >= 0 ? '#f4a840' : '#008c9e';
                    }
                })
                .text(d => (d.importance >= 0 ? '+' : '') + d.importance.toFixed(3));

            // Feature labels
            g.selectAll('.feature-label')
                .data(chartData)
                .enter()
                .append('text')
                .attr('class', 'feature-label')
                .attr('y', d => yScale(d.feature) + yScale.bandwidth() / 2)
                .attr('x', -10)
                .attr('dy', '0.35em')
                .attr('text-anchor', 'end')
                .style('font-size', '12px')
                .style('fill', '#666')
                .text(d => d.description);

            // Headers das classes no topo do gráfico
            g.append('text')
                .attr('x', xScale(0) - 100)
                .attr('y', -5)
                .attr('text-anchor', 'middle')
                .style('font-size', '14px')
                .style('font-weight', 'bold')
                .style('fill', '#008c9e')
                .text('tested_negative');

            g.append('text')
                .attr('x', xScale(0) + 100)
                .attr('y', -5)
                .attr('text-anchor', 'middle')
                .style('font-size', '14px')
                .style('font-weight', 'bold')
                .style('fill', '#f4a840')
                .text('tested_positive');

            // Eixo x
            g.append('g')
                .attr('class', 'axis')
                .attr('transform', `translate(0,${height})`)
                .call(d3.axisBottom(xScale).tickFormat(d3.format('.2f')));

            // Label do eixo x
            g.append('text')
                .attr('class', 'axis-label')
                .attr('transform', `translate(${width / 2}, ${height + 50})`)
                .style('text-anchor', 'middle')
                .style('fill', '#666')
                .style('font-size', '12px')
                .text('Feature Importance (LIME values)');

            // Adicionar prediction probabilities
            if (predictionData && predictionData.class_probabilities) {
                // Título
                const titleDiv = document.createElement('div');
                titleDiv.innerHTML = '<h4 style="margin: 0; color: #333; text-align:left; margin-bottom: 15px;">Prediction probabilities:</h4>';
                probContainer.appendChild(titleDiv);

                // Classes
                const classProbabilities = predictionData.class_probabilities;
                const classNames = Object.keys(classProbabilities);

                classNames.forEach(className => {
                    const probability = classProbabilities[className];
                    const color = className.includes('negative') ? '#008c9e' : '#f4a840';

                    const classDiv = document.createElement('div');
                    classDiv.style.cssText = `
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 10px;
            `;

                    // Container para o retângulo com preenchimento
                    const barContainer = document.createElement('div');
                    barContainer.style.cssText = `
                width: 120px;
                height: 25px;
                border: 2px solid #ccc;
                background-color: #f9f9f9;
                position: relative;
                overflow: hidden;
            `;

                    // Retângulo preenchido
                    const filledBar = document.createElement('div');
                    filledBar.style.cssText = `
                width: ${probability * 100}%;
                height: 100%;
                background-color: ${color};
                position: absolute;
                left: 0;
                top: 0;
            `;

                    // Texto da probabilidade
                    const probabilityText = document.createElement('div');
                    probabilityText.style.cssText = `
                position: absolute;
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: bold;
                color: #333;
                z-index: 1;
            `;
                    probabilityText.textContent = probability.toFixed(2);

                    barContainer.appendChild(filledBar);
                    barContainer.appendChild(probabilityText);

                    // Label da classe
                    const classLabel = document.createElement('span');
                    classLabel.style.cssText = `
                color: ${color};
                font-weight: bold;
                min-width: 120px;
            `;
                    classLabel.textContent = className;

                    classDiv.appendChild(classLabel);
                    classDiv.appendChild(barContainer);
                    probContainer.appendChild(classDiv);
                });
            }

            container.appendChild(chartContainer);
            container.appendChild(probContainer);
        }

        function createWaterfallChart(instanceNum) {
            const container = document.getElementById(`explanation-chart-${instanceNum}`);
            container.innerHTML = '';

            if (!explanationData) return;

            const shapValues = explanationData.shap_explanations[`sample_${instanceNum}`];
            if (!shapValues) return;

            const predictionData = explanationData.predictions[`sample_${instanceNum}`];

            // Container para o chart
            const chartContainer = document.createElement('div');

            // Container para probabilities
            const probContainer = document.createElement('div');
            probContainer.style.display = 'flex';
            probContainer.style.flexDirection = 'column';

            const features = Object.keys(shapValues);
            const values = Object.values(shapValues);

            const baseline = explanationData.metadata ? explanationData.metadata.baseline_value : 0;

            // Ordenação do menor para maior
            const sortedData = features.map((feature, i) => ({
                feature: feature.split(' = ')[0],
                value: feature.split(' = ')[1],
                impact: values[i],
                isPositive: values[i] > 0
            })).sort((a, b) => Math.abs(a.impact) - Math.abs(b.impact));

            // Calculo da posição acumulada das feature bars começando pela baseline
            let cumulativeValue = baseline;
            const waterfallData = sortedData.map(d => {
                const start = cumulativeValue;
                cumulativeValue += d.impact;
                return {
                    ...d,
                    start: start,
                    end: cumulativeValue
                };
            });

            const finalPrediction = cumulativeValue;

            // Dimensões
            const margin = {top: 20, right: 120, bottom: 60, left: 240};
            const width = 800 - margin.left - margin.right;
            const height = 400 - margin.top - margin.bottom;

            const svg = d3.select(chartContainer)
                .append('svg')
                .attr('width', width + margin.left + margin.right)
                .attr('height', height + margin.top + margin.bottom)
                .attr('class', 'waterfall-chart');

            const g = svg.append('g')
                .attr('transform', `translate(${margin.left},${margin.top})`);

            const yScale = d3.scaleBand()
                .range([0, height])
                .domain(waterfallData.map(d => d.feature).reverse())
                .padding(0.3);

            const allValues = [baseline, ...waterfallData.map(d => d.start), ...waterfallData.map(d => d.end), finalPrediction];
            const xExtent = d3.extent(allValues);
            const xScale = d3.scaleLinear()
                .range([0, width])
                .domain([Math.min(xExtent[0], 0) * 1.1, Math.max(xExtent[1], 0) * 1.1])
                .nice();

            // Tooltip
            const tooltip = d3.select(`#tooltip-${instanceNum}`);

            // Conectores entre as barras
            waterfallData.forEach((d, i) => {
                if (i < waterfallData.length - 1) {
                    const nextData = waterfallData[i + 1];
                    g.append('line')
                        .attr('class', 'connector-line')
                        .attr('x1', xScale(d.end))
                        .attr('x2', xScale(d.end))
                        .attr('y1', yScale(d.feature) + yScale.bandwidth())
                        .attr('y2', yScale(nextData.feature))
                        .attr('stroke', '#ccc')
                        .attr('stroke-width', 2)
                        .attr('stroke-dasharray', '3,3');
                }
            });

            // Feature bars
            g.selectAll('.waterfall-bar')
                .data(waterfallData)
                .enter()
                .append('rect')
                .attr('class', 'waterfall-bar bar')
                .attr('y', d => yScale(d.feature))
                .attr('height', yScale.bandwidth())
                .attr('x', d => xScale(Math.min(d.start, d.end)))
                .attr('width', d => Math.abs(xScale(d.end) - xScale(d.start)))
                .attr('fill', d => d.isPositive ? '#f4a840' : '#008c9e')
                .attr('stroke', '#fff')
                .attr('stroke-width', 1)
                .on('mouseover', function (event, d) {
                    const rect = this.getBoundingClientRect();
                    tooltip.style('opacity', 1)
                        .style('visibility', 'visible')
                        .html(`
            <strong>${d.feature}</strong><br/>
            Value: ${d.value}<br/>
            SHAP Impact: ${d.impact.toFixed(4)}<br/>
            Cumulative: ${d.end.toFixed(4)}
        `)
                        .style('position', 'fixed')
                        .style('left', `${rect.right + 20}px`)
                        .style('top', `${rect.top + window.scrollY - 8}px`);
                })
                .on('mouseout', function () {
                    tooltip.style('opacity', 0)
                })

            // Função para determinar se o label do valor cabe na feature bar
            function labelFitsInBar(d) {
                const barWidth = Math.abs(xScale(d.end) - xScale(d.start));
                const labelText = (d.impact >= 0 ? '+' : '') + d.impact.toFixed(3);
                const estimatedTextWidth = labelText.length * 6;
                return barWidth > estimatedTextWidth + 10;
            }

            // Label dinâmico dos valores das feature bars
            g.selectAll('.bar-label')
                .data(waterfallData)
                .enter()
                .append('text')
                .attr('class', 'bar-label')
                .attr('y', d => yScale(d.feature) + yScale.bandwidth() / 2)
                .attr('x', d => {
                    const fitsInside = labelFitsInBar(d);

                    if (fitsInside) {
                        return (xScale(d.start) + xScale(d.end)) / 2;
                    } else {
                        if (d.impact >= 0) {
                            return xScale(d.end) + 5;
                        } else {
                            return xScale(d.end) - 5;
                        }
                    }
                })
                .attr('dy', '0.35em')
                .attr('text-anchor', d => {
                    const fitsInside = labelFitsInBar(d);

                    if (fitsInside) {
                        return 'middle';
                    } else {
                        if (d.impact >= 0) {
                            return 'start';
                        } else {
                            return 'end';
                        }
                    }
                })
                .style('font-size', '11px')
                .style('font-weight', 'bold')
                .style('fill', d => {
                    const fitsInside = labelFitsInBar(d);

                    if (fitsInside) {
                        return 'white';
                    } else {
                        return d.impact >= 0 ? '#f4a840' : '#008c9e';
                    }
                })
                .text(d => (d.impact >= 0 ? '+' : '') + d.impact.toFixed(3));

            // Label das features 
            g.selectAll('.feature-label')
                .data([...waterfallData])
                .enter()
                .append('text')
                .attr('class', 'feature-label')
                .attr('y', d => yScale(d.feature) + yScale.bandwidth() / 2)
                .attr('x', -10)
                .attr('dy', '0.35em')
                .attr('text-anchor', 'end')
                .style('font-size', '12px')
                .style('fill', '#666')
                .text(d => d.feature === 'f(x)' ? 'f(x)' : `${d.feature} = ${d.value}`);

            // Linha 0 de referência
            if (baseline !== 0) {
                g.append('line')
                    .attr('class', 'zero-line')
                    .attr('x1', xScale(0))
                    .attr('x2', xScale(0))
                    .attr('y1', 0)
                    .attr('y2', height)
                    .attr('stroke', '#999')
                    .attr('stroke-width', 1);
            }

            // Conector da baseline para a primeira feature bar
            const firstFeature = waterfallData[0];
            g.append('line')
                .attr('class', 'baseline-connector')
                .attr('x1', xScale(baseline))
                .attr('x2', xScale(firstFeature.start))
                .attr('y1', height)
                .attr('y2', yScale(firstFeature.feature) + yScale.bandwidth() / 2)
                .attr('stroke', '#ccc')
                .attr('stroke-width', 2)
                .attr('stroke-dasharray', '3,3');

            // Eixo x
            g.append('g')
                .attr('class', 'axis')
                .attr('transform', `translate(0,${height})`)
                .call(d3.axisBottom(xScale).tickFormat(d3.format('.2f')));

            // Label do eixo x
            g.append('text')
                .attr('class', 'axis-label')
                .attr('transform', `translate(${width / 2}, ${height + 60})`)
                .style('text-anchor', 'middle')
                .style('fill', '#666')
                .text('SHAP Value (impact on model output)');

            // E[f(x)] label
            g.append('text')
                .attr('class', 'baseline-x-label')
                .attr('x', xScale(baseline))
                .attr('y', height + 35)
                .style('text-anchor', 'middle')
                .style('font-size', '11px')
                .style('fill', '#666')
                .text(`E[f(X)] = ${baseline.toFixed(4)}`);

            // Linha final de predição
            g.append('line')
                .attr('class', 'fx-line')
                .attr('x1', xScale(finalPrediction))
                .attr('x2', xScale(finalPrediction))
                .attr('y1', -10)
                .attr('y2', height + 10)
                .attr('stroke', '#666')
                .attr('stroke-width', 2)
                .attr('stroke-dasharray', '4,2');

            // f(x) label
            g.append('text')
                .attr('transform', `translate(${xScale(finalPrediction) - 5}, -5)`)
                .style('text-anchor', 'end')
                .style('font-size', '11px')
                .style('fill', '#34495e')
                .text(`f(x) = ${finalPrediction.toFixed(3)}`);

            // Adicionar prediction probabilities
            if (predictionData && predictionData.class_probabilities) {
                // Título
                const titleDiv = document.createElement('div');
                titleDiv.innerHTML = '<h4 style="margin: 0; color: #333; text-align:left; margin-bottom: 15px;">Prediction probabilities:</h4>';
                probContainer.appendChild(titleDiv);

                // Classes
                const classProbabilities = predictionData.class_probabilities;
                const classNames = Object.keys(classProbabilities);

                classNames.forEach(className => {
                    const probability = classProbabilities[className];
                    const color = className.includes('negative') ? '#008c9e' : '#f4a840';

                    const classDiv = document.createElement('div');
                    classDiv.style.cssText = `
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 10px;
            `;

                    // Container para o retângulo com preenchimento
                    const barContainer = document.createElement('div');
                    barContainer.style.cssText = `
                width: 120px;
                height: 25px;
                border: 2px solid #ccc;
                background-color: #f9f9f9;
                position: relative;
                overflow: hidden;
            `;

                    // Retângulo preenchido
                    const filledBar = document.createElement('div');
                    filledBar.style.cssText = `
                width: ${probability * 100}%;
                height: 100%;
                background-color: ${color};
                position: absolute;
                left: 0;
                top: 0;
            `;

                    // Texto da probabilidade
                    const probabilityText = document.createElement('div');
                    probabilityText.style.cssText = `
                position: absolute;
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: bold;
                color: #333;
                z-index: 1;
            `;
                    probabilityText.textContent = probability.toFixed(3);

                    barContainer.appendChild(filledBar);
                    barContainer.appendChild(probabilityText);

                    // Label da classe
                    const classLabel = document.createElement('span');
                    classLabel.style.cssText = `
                color: ${color};
                font-weight: bold;
                min-width: 120px;
            `;
                    classLabel.textContent = className;

                    classDiv.appendChild(classLabel);
                    classDiv.appendChild(barContainer);
                    probContainer.appendChild(classDiv);
                });
            }

            container.appendChild(chartContainer);
            container.appendChild(probContainer);
        }

        // Observa mudanças no DOM para adicionar event listeners após criação dos elementos
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                    const hasInstanceElements = Array.from(mutation.addedNodes).some(node =>
                        node.id && node.id.includes('step') && parseInt(node.getAttribute('data-step')) > 2
                    );

                    if (hasInstanceElements) {
                        // Aguarda um pequeno delay para garantir que todos os elementos foram criados
                        setTimeout(() => {
                            addInstanceEventListeners();
                        }, 100);
                    }
                }
            });
        });

        // Inicia observação do container dinâmico
        observer.observe(document.getElementById('dynamic-instances-container'), {
            childList: true,
            subtree: true
        });
    </script>
    <script>
        let currentStep = 0;

        function getEnabledSteps() {
            return document.querySelectorAll('.step:not(.disabled)');
        }

        function getCurrentStep() {
            const enabledSteps = getEnabledSteps();
            return enabledSteps[currentStep];
        }

        function updateContainerStyle() {
            const container = document.getElementById("container-geral");
            const enabledSteps = getEnabledSteps();

            if (enabledSteps.length === 0) return;

            const currentStepElement = enabledSteps[currentStep];
            const currentGroup = currentStepElement.getAttribute('data-group');

            container.classList.remove('group-blue', 'group-orange');

            const groupOrder = [];
            enabledSteps.forEach(step => {
                const group = step.getAttribute('data-group');
                if (!groupOrder.includes(group)) {
                    groupOrder.push(group);
                }
            });

            const groupIndex = groupOrder.indexOf(currentGroup);
            const colorClass = (groupIndex % 2 === 0) ? 'group-blue' : 'group-orange';
            container.classList.add(colorClass);
        }

        function isLastInstanceStep() {
            const enabledSteps = getEnabledSteps();
            const currentStepElement = enabledSteps[currentStep];
            const stepNumber = parseInt(currentStepElement.getAttribute('data-step'));

            // Verifica se é o último step de previsão
            const lastInstanceStepNumber = 2 + (totalInstances * 2);
            return stepNumber === lastInstanceStepNumber;
        }

        function showStep(stepIndex) {
            const enabledSteps = getEnabledSteps();

            document.querySelectorAll('.step').forEach(step => {
                step.classList.remove('active');
            });

            if (enabledSteps[stepIndex]) {
                enabledSteps[stepIndex].classList.add('active');
            }

            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");

            prevBtn.disabled = (stepIndex === 0);

            // Verifica se está processando explicações ou Fine Tuning para desabilitar o botão next
            if (isProcessingExplanations || isProcessingFineTuning) {
                nextBtn.disabled = true;
            } else {
                // Para o step2, sempre habilita o botão next
                const currentStepElement = enabledSteps[stepIndex];
                const stepNumber = parseInt(currentStepElement.getAttribute('data-step'));

                if (stepNumber === 2) {
                    nextBtn.disabled = false;
                } else {
                    nextBtn.disabled = (stepIndex === enabledSteps.length - 1);
                }

                if (totalInstances > 0 && isLastInstanceStep()) {
                    nextBtn.textContent = "Optimize Model";
                } else {
                    nextBtn.textContent = "Next";
                }
            }

            updateContainerStyle();
        }

        function nextStep() {
            if (isLastInstanceStep() && validateStep(currentStep)) {
                processFineTuning();
                return;
            }

            if (validateStep(currentStep)) {
                const enabledSteps = getEnabledSteps();
                if (currentStep < enabledSteps.length - 1) {
                    currentStep++;
                    showStep(currentStep);
                }
            }
        }

        function prevStep() {
            if (currentStep > 0) {
                currentStep--;
                showStep(currentStep);
            }
        }

        function validateStep(stepIndex) {
            const enabledSteps = getEnabledSteps();
            const currentStepElement = enabledSteps[stepIndex];
            const stepNumber = parseInt(currentStepElement.getAttribute('data-step'));

            // Validação para step2
            if (stepNumber === 2) {
                const errorMessageStep2 = document.getElementById('error-message-step2');
                validateStep2Live();

                // Se está processando explicações, não permite avançar
                if (isProcessingExplanations) {
                    return false;
                }

                // Verifica se precisa executar/reexecutar as explicações
                const currentSelectedExplainer = getSelectedExplainer();
                const needsExecution = errorMessageStep2.innerText === "" &&
                    (!explanationsExecuted || lastSelectedExplainer !== currentSelectedExplainer) &&
                    !isProcessingExplanations;

                if (needsExecution) {
                    executeExplanations();
                    return false;
                }

                return errorMessageStep2.innerText === "";
            }

            // Validação para steps de predição do usuário (ímpares >= 3)
            if (stepNumber >= 3 && stepNumber % 2 === 1) {
                const instanceNum = Math.floor((stepNumber - 3) / 2) + 1;
                const errorMessage = document.getElementById(`error-message-step${stepNumber}`);

                if (instanceSelections[instanceNum]) {
                    validateSelectionUser(instanceNum, "next");
                    return errorMessage.innerText === "";
                }
                return false;
            }

            // Validação para steps de predição do modelo (pares >= 4)
            if (stepNumber >= 4 && stepNumber % 2 === 0) {
                const instanceNum = Math.floor((stepNumber - 4) / 2) + 1;
                const errorMessage = document.getElementById(`error-message-step${stepNumber}`);
                validateSelectionModel(instanceNum);
                return errorMessage.innerText === "";
            }

            // step_FineTuning sempre válido
            if (currentStepElement.getAttribute('data-group') === 'FineTuning') {
                return true;
            }

            return true;
        }

        // Função para atualizar navegação após carregar steps dinâmicos
        function updateNavigationAfterDynamicLoad() {
            setTimeout(() => {
                showStep(currentStep);
            }, 200);
        }

        // Inicialização
        showStep(currentStep);
    </script>
    <script>
        document.querySelectorAll('.option-tooltip').forEach(container => {
            const icon = container.querySelector('.tooltip-icon');
            const tooltip = container.querySelector('.tooltip-text');

            icon.addEventListener('mouseenter', () => {
                const rect = icon.getBoundingClientRect();
                tooltip.classList.add('fixed-tooltip');
                tooltip.style.top = `${rect.top + window.scrollY + rect.height - 8}px`;
                tooltip.style.left = `${rect.right + rect.width - 15}px`;
                tooltip.style.visibility = 'visible';
                tooltip.style.opacity = '1';
            });

            icon.addEventListener('mouseleave', () => {
                tooltip.classList.remove('fixed-tooltip');
                tooltip.style.visibility = '';
                tooltip.style.opacity = '';
                tooltip.style.top = '';
                tooltip.style.left = '';
            });
        });
    </script>
</body>

