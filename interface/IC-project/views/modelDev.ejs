                        <script>
                            const checkboxACC = document.getElementById('acc');
                            const checkboxROC_AUC = document.getElementById('roc_auc');
                            const checkboxF1 = document.getElementById('f1');
                            const checkboxPRECISION = document.getElementById('precision');
                            const checkboxRECALL = document.getElementById('recall');
                            const errorMessageSM = document.getElementById('error-message-SM');

                            const allCheckboxes = [checkboxACC, checkboxROC_AUC, checkboxF1, checkboxPRECISION, checkboxRECALL];

                            function validateSM() {
                                const checkedCount = allCheckboxes.filter(cb => cb.checked).length;

                                if (checkedCount === 0) {
                                    errorMessageSM.style.display = 'block';
                                    errorMessageSM.innerText = "Select one score metric to be used.";
                                } else if (checkedCount > 1) {
                                    errorMessageSM.style.display = 'block';
                                    errorMessageSM.innerText = "Select only one score metric.";
                                } else {
                                    errorMessageSM.style.display = 'none';
                                    errorMessageSM.innerText = ""
                                }

                                if (document.getElementById('gerarConfig')) {
                                    validateGerarConfig();
                                }
                            }
                            function handleCheckboxChange(clickedCheckbox) {
                                if (clickedCheckbox.checked) {
                                    // Uncheck all other checkboxes
                                    allCheckboxes.forEach(cb => {
                                        if (cb !== clickedCheckbox) {
                                            cb.checked = false;
                                        }
                                    });
                                }
                                validateSM();
                            }

                            // Rodar no carregamento inicial
                            validateSM();

                            // Adicionar listeners
                            allCheckboxes.forEach(checkbox => {
                                checkbox.addEventListener('change', () => handleCheckboxChange(checkbox));
                            });
                        </script>
                        <button id="gerarConfig" type="button">Train Model</button>
                        <script>
                            function validateGerarConfig() {
                                const gerarConfig = document.getElementById('gerarConfig');
                                if (!gerarConfig) return;

                                const errorMessage = document.getElementsByClassName('error-message');
                                const hasErrors = Array.from(errorMessage).some(element => element.innerText.trim() !== "");

                                gerarConfig.disabled = hasErrors;
                                gerarConfig.classList.toggle('disabled', hasErrors);
                            }
                        </script>
                        <div id="confirmationModal" class="modal">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h2 class="modal-title">Summary</h2>
                                    <span class="close" id="closeModal">&times;</span>
                                </div>

                                <div class="params-container">
                                    <div id="parametersDisplay"></div>
                                </div>

                                <div class="modal-buttons">
                                    <button class="modal-btn btn-cancel" id="cancelBtn">Cancel</button>
                                    <button class="modal-btn btn-confirm" id="confirmBtn">Confirm</button>
                                </div>
                            </div>
                        </div>
                        <script>
                            document.getElementById('gerarConfig').addEventListener('click', () => {
                                // Verifica se algum erro existe
                                const errorMessage = document.getElementsByClassName('error-message');
                                for (let i = 0; i < errorMessage.length; i++) {
                                    if (errorMessage[i].innerText.trim() !== "") {
                                        return;
                                    }
                                }

                                // Numero de folds
                                const foldInput = parseInt(document.getElementById('foldInput').value);

                                let foldConfig = '';
                                if (foldInput) {
                                    foldConfig = `NumFolds: ${foldInput}`;
                                }

                                //Scaling
                                const minmax = document.getElementById('minmax').checked;
                                const standard = document.getElementById('standard').checked;
                                const robust = document.getElementById('robust').checked;

                                let sacalerConfig = '';
                                if (minmax || standard || robust) {
                                    let scalerValues = [];
                                    if (minmax) scalerValues.push('MinMaxScaler');
                                    if (standard) scalerValues.push('StandardScaler');
                                    if (robust) scalerValues.push('RobustScaler');
                                    scalerConfig = `Scalers: ${scalerValues.join(', ')}`;
                                }

                                //K
                                const k1Input = parseInt(document.getElementById('k1').value);
                                const k2Input = parseInt(document.getElementById('k2').value);

                                let kConfig = '';
                                if (k1Input && k2Input) {
                                    kConfig = `minK: ${k1Input}, maxK: ${k2Input}`;
                                }

                                //Model Selection
                                const mlp_classif = document.getElementById('MLP').checked;
                                const random_forest = document.getElementById('RandomForest').checked;
                                let modelSelectionConfig = '';
                                if (mlp_classif || random_forest) {
                                    let modelSelectionValues = [];
                                    if (mlp_classif) modelSelectionValues.push('MLP Classifier');
                                    if (random_forest) modelSelectionValues.push('Random Forest');
                                    modelSelectionConfig = `Model Selection: ${modelSelectionValues.join(', ')}`;
                                }

                                //Score Function
                                const f_classif = document.getElementById('f_classif').checked;
                                const chi2 = document.getElementById('chi2').checked;
                                const mutual_info_classif = document.getElementById('mutual_info_classif').checked;

                                let scoreFunctionConfig = '';
                                if (f_classif || chi2 || mutual_info_classif) {
                                    let scoreFunctionValues = [];
                                    if (f_classif) scoreFunctionValues.push('f_classif');
                                    if (chi2) scoreFunctionValues.push('chi2');
                                    if (mutual_info_classif) scoreFunctionValues.push('mutual_info_classif');
                                    scoreFunctionConfig = `Score Function: ${scoreFunctionValues.join(', ')}`;
                                }

                                // Hiperparâmetros do MLP Classifier
                                //Activation Funcion
                                const relu = document.getElementById('relu').checked;
                                const logistic = document.getElementById('logistic').checked;
                                const tanh = document.getElementById('tanh').checked;
                                const identity = document.getElementById('identity').checked;

                                let activationFunctionConfig = '';
                                if (relu || logistic || tanh || identity) {
                                    let activationFunctionValues = [];
                                    if (relu) activationFunctionValues.push('relu');
                                    if (logistic) activationFunctionValues.push('logistic');
                                    if (tanh) activationFunctionValues.push('tanh');
                                    if (identity) activationFunctionValues.push('identity');
                                    activationFunctionConfig = `Activation Function: ${activationFunctionValues.join(', ')}`;
                                }

                                //Solver
                                const adam = document.getElementById('adam').checked;
                                const lbfgs = document.getElementById('lbfgs').checked;
                                const sgd = document.getElementById('sgd').checked;

                                let solverConfig = '';
                                if (adam || lbfgs || sgd) {
                                    let solverValues = [];
                                    if (adam) solverValues.push('adam');
                                    if (lbfgs) solverValues.push('lbfgs');
                                    if (sgd) solverValues.push('sgd');
                                    solverConfig = `Solver: ${solverValues.join(', ')}`;
                                }

                                //Learning Rate
                                const constant = document.getElementById('constant').checked;
                                const adaptive = document.getElementById('adaptive').checked;
                                const invscaling = document.getElementById('invscaling').checked;

                                let learningRateConfig = '';
                                if (constant || adaptive || invscaling) {
                                    let learningRateValues = [];
                                    if (constant) learningRateValues.push('constant');
                                    if (adaptive) learningRateValues.push('adaptive');
                                    if (invscaling) learningRateValues.push('invscaling');
                                    learningRateConfig = `Learning Rate: ${learningRateValues.join(', ')}`;
                                }

                                //Initial Learning Rate
                                const lr1Input = parseFloat(document.getElementById('lr1').value);
                                const lr2Input = parseFloat(document.getElementById('lr2').value);

                                let lrConfig = '';
                                if (lr1Input && lr2Input) {
                                    lrConfig = `minLearningRateInit: ${lr1Input}, maxLearningRateInit: ${lr2Input}`;
                                }

                                // Alfa
                                const alpha1Input = parseFloat(document.getElementById('alpha1').value);
                                const alpha2Input = parseFloat(document.getElementById('alpha2').value);

                                let alfaConfig = '';
                                if (alpha1Input && alpha2Input) {
                                    alfaConfig = `minAlfa: ${alpha1Input}, maxAlfa: ${alpha2Input}`;
                                }

                                // Hidden Layer
                                const configs = document.getElementById('configs').children;
                                const hiddenLayerSizes = [];

                                let hiddenLayerConfig = '';
                                if (configs) {
                                    for (let configuracao of configs) {
                                        const numLayersInput = configuracao.querySelector('#numLayers');
                                        const layerInputsDiv = configuracao.querySelectorAll('#layerInputs input');

                                        const numLayers = parseInt(numLayersInput.value);
                                        const layerSizes = [];

                                        // Captura o valor de neurônios de cada camada
                                        for (let i = 0; i < numLayers; i++) {
                                            const neuronios = parseInt(layerInputsDiv[i].value);
                                            if (!isNaN(neuronios)) {
                                                layerSizes.push(neuronios);
                                            }
                                        }

                                        // Adiciona ao array no formato de tupla
                                        if (layerSizes.length > 0) {
                                            hiddenLayerSizes.push(`(${layerSizes.join(', ')})`);
                                        }
                                    }
                                    // Monta a string no formato Grid Search
                                    hiddenLayerConfig = `Hidden Layer Sizes: ${hiddenLayerSizes.join(', ')}`;
                                }

                                // Numero de Epocas
                                const epoch1Input = parseInt(document.getElementById('epoch1').value);
                                const epoch2Input = parseInt(document.getElementById('epoch2').value);

                                let epochConfig = '';
                                if (epoch1Input && epoch2Input) {
                                    epochConfig = `minEpochs: ${epoch1Input}, maxEpochs: ${epoch2Input}`;
                                }


                                // Hiperparâmetros do RandomForest
                                // Number of Estimators
                                const nEstimators1Input = parseInt(document.getElementById('nEstimators1').value);
                                const nEstimators2Input = parseInt(document.getElementById('nEstimators2').value);

                                let nEstimatorsConfig = '';
                                if (nEstimators1Input && nEstimators2Input) {
                                    nEstimatorsConfig = `minNEstimators: ${nEstimators1Input}, maxNEstimators: ${nEstimators2Input}`;
                                }

                                // Max Depth
                                const depth1Input = parseInt(document.getElementById('depth1').value);
                                const depth2Input = parseInt(document.getElementById('depth2').value);

                                let maxDepthConfig = '';
                                if (depth1Input && depth2Input) {
                                    maxDepthConfig = `minMaxDepth: ${depth1Input}, maxMaxDepth: ${depth2Input}`;
                                }

                                // Max Features
                                const sqrt = document.getElementById('sqrt').checked;
                                const log2 = document.getElementById('log2').checked;
                                const noneMF = document.getElementById('noneMF').checked;

                                let maxFeaturesConfig = '';
                                if (sqrt || log2 || noneMF) {
                                    let maxFeaturesValues = [];
                                    if (sqrt) maxFeaturesValues.push('sqrt');
                                    if (log2) maxFeaturesValues.push('log2');
                                    if (noneMF) maxFeaturesValues.push('None');
                                    maxFeaturesConfig = `Max Features: ${maxFeaturesValues.join(', ')}`;
                                }

                                // Criterion
                                const gini = document.getElementById('gini').checked;
                                const entropy = document.getElementById('entropy').checked;
                                const log_loss = document.getElementById('log_loss').checked;

                                let criterionConfig = '';
                                if (gini || entropy || log_loss) {
                                    let criterionValues = [];
                                    if (gini) criterionValues.push('gini');
                                    if (entropy) criterionValues.push('entropy');
                                    if (log_loss) criterionValues.push('log_loss');
                                    criterionConfig = `Criterion: ${criterionValues.join(', ')}`;
                                }

                                // Min Samples Leaf
                                const minSamplesLeaf1Input = parseInt(document.getElementById('minSamplesLeaf1').value);
                                const minSamplesLeaf2Input = parseInt(document.getElementById('minSamplesLeaf2').value);

                                let minSamplesLeafConfig = '';
                                if (minSamplesLeaf1Input && minSamplesLeaf2Input) {
                                    minSamplesLeafConfig = `minMinSamplesLeaf: ${minSamplesLeaf1Input}, maxMinSamplesLeaf: ${minSamplesLeaf2Input}`;
                                }

                                // Min Samples Split
                                const minSamplesSplit1Input = parseInt(document.getElementById('minSamplesSplit1').value);
                                const minSamplesSplit2Input = parseInt(document.getElementById('minSamplesSplit2').value);

                                let minSamplesSplitConfig = '';
                                if (minSamplesSplit1Input && minSamplesSplit2Input) {
                                    minSamplesSplitConfig = `minMinSamplesSplit: ${minSamplesSplit1Input}, maxMinSamplesSplit: ${minSamplesSplit2Input}`;
                                }

                                // Numero de Trials
                                const nTrialsInput = parseInt(document.getElementById('nTrials').value);

                                let nTrialsConfig = '';
                                if (nTrialsInput) {
                                    nTrialsConfig = `NumTrials: ${nTrialsInput}`;
                                }

                                // Metrica avaliada
                                const acc = document.getElementById('acc').checked;
                                const roc_auc = document.getElementById('roc_auc').checked;
                                const f1 = document.getElementById('f1').checked;
                                const precision = document.getElementById('precision').checked;
                                const recall = document.getElementById('recall').checked;

                                if (acc || roc_auc || f1 || precision || recall) {
                                    let scoreMetricValue = [];
                                    if (acc) scoreMetricValue.push('accuracy');
                                    if (roc_auc) scoreMetricValue.push('roc_auc');
                                    if (f1) scoreMetricValue.push('f1_weighted');
                                    if (precision) scoreMetricValue.push('precision_weighted');
                                    if (recall) scoreMetricValue.push('recall_weighted');

                                    scoreMetricConfig = `Score Metric: ${scoreMetricValue.join(', ')}`;
                                }

                                // Variavel alvo e excluidas
                                const targetSelecionadas = [];
                                const deletedSelecionadas = [];

                                const variaveisTargetElements = document.querySelectorAll('#checkbox-list-target input:checked');
                                variaveisTargetElements.forEach(element => targetSelecionadas.push(element.value));

                                const variaveisDeletedElements = document.querySelectorAll('#checkbox-list-deleted input:checked');
                                variaveisDeletedElements.forEach(element => deletedSelecionadas.push(element.value));

                                let conteudoFinal = '';
                                if (mlp_classif) {
                                    conteudoFinal = `${foldConfig}\n${nTrialsConfig}\n${scoreMetricConfig}\n${scalerConfig}\n${kConfig}\n${scoreFunctionConfig}\n${modelSelectionConfig}\n${activationFunctionConfig}\n${solverConfig}\n${learningRateConfig}\n${lrConfig}\n${alfaConfig}\n${hiddenLayerConfig}\n${epochConfig}\nVar Target: ${targetSelecionadas.join(', ')}\nVar Deleted: ${deletedSelecionadas.join(', ')}`;
                                } else if (random_forest) {
                                    conteudoFinal = `${foldConfig}\n${nTrialsConfig}\n${scoreMetricConfig}\n${scalerConfig}\n${kConfig}\n${scoreFunctionConfig}\n${modelSelectionConfig}\n${nEstimatorsConfig}\n${maxDepthConfig}\n${maxFeaturesConfig}\n${criterionConfig}\n${minSamplesLeafConfig}\n${minSamplesSplitConfig}\nVar Target: ${targetSelecionadas.join(', ')}\nVar Deleted: ${deletedSelecionadas.join(', ')}`;
                                }
                                currentConfig = {conteudoFinal};

                                let parametersArray = [
                                    {label: 'Target Variable', value: targetSelecionadas.length > 0 ? targetSelecionadas.join(', ') : 'None selected'},
                                    {label: 'Deleted Variables', value: deletedSelecionadas.length > 0 ? deletedSelecionadas.join(', ') : 'None selected'},
                                    {label: 'Feature Scaling', value: scalerConfig.replace('Scalers: ', '') || 'None selected'},
                                    ...(k1Input && k2Input ? [
                                        {type: 'range', label1: 'Min K', value1: k1Input.toString(), label2: 'Max K', value2: k2Input.toString()}
                                    ] : [{label: 'K Range', value: 'Not defined'}]),
                                    {label: 'Model Selection', value: modelSelectionConfig.replace('Model Selection: ', '') || 'None selected'},
                                    {label: 'Score Function', value: scoreFunctionConfig.replace('Score Function: ', '') || 'None selected'},
                                    {label: 'Number of Folds', value: foldConfig.replace('NumFolds: ', '') || 'Not defined'},
                                    {label: 'Number of Trials', value: nTrialsConfig.replace('NumTrials: ', '') || 'Not defined'},
                                    {label: 'Score Metric', value: scoreMetricConfig.replace('Score Metric: ', '') || 'None selected'}
                                ];

                                // Adicionar parâmetros específicos do modelo selecionado
                                if (mlp_classif) {
                                    parametersArray.push(
                                        {label: 'Activation Function', value: activationFunctionConfig.replace('Activation Function: ', '') || 'None selected'},
                                        {label: 'Solver', value: solverConfig.replace('Solver: ', '') || 'None selected'},
                                        {label: 'Learning Rate Schedule', value: learningRateConfig.replace('Learning Rate: ', '') || 'Not defined'},
                                        ...(lr1Input && lr2Input ? [
                                            {type: 'range', label1: 'Learning Rate (Min)', value1: lr1Input.toString(), label2: 'Learning Rate (Max)', value2: lr2Input.toString()}
                                        ] : [{label: 'Initial Learning Rate Range', value: 'Not defined'}]),
                                        ...(alpha1Input && alpha2Input ? [
                                            {type: 'range', label1: 'Alpha (Min)', value1: alpha1Input.toString(), label2: 'Alpha (Max)', value2: alpha2Input.toString()}
                                        ] : [{label: 'Alpha', value: 'Not defined'}]),
                                        {label: 'Hidden Layer Configurations', value: hiddenLayerConfig.replace('Hidden Layer Sizes: ', '') || 'Not defined'},
                                        ...(epoch1Input && epoch2Input ? [
                                            {type: 'range', label1: 'Epochs (Min)', value1: epoch1Input.toString(), label2: 'Epochs (Max)', value2: epoch2Input.toString()}
                                        ] : [{label: 'Epochs Range', value: 'Not defined'}])
                                    );
                                } else if (random_forest) {
                                    parametersArray.push(
                                        ...(nEstimators1Input && nEstimators2Input ? [
                                            {type: 'range', label1: 'N Estimators (Min)', value1: nEstimators1Input.toString(), label2: 'N Estimators (Max)', value2: nEstimators2Input.toString()}
                                        ] : [{label: 'N Estimators Range', value: 'Not defined'}]),
                                        ...(depth1Input && depth2Input ? [
                                            {type: 'range', label1: 'Max Depth (Min)', value1: depth1Input.toString(), label2: 'Max Depth (Max)', value2: depth2Input.toString()}
                                        ] : [{label: 'Max Depth Range', value: 'Not defined'}]),
                                        {label: 'Max Features', value: maxFeaturesConfig.replace('Max Features: ', '') || 'None selected'},
                                        {label: 'Criterion', value: criterionConfig.replace('Criterion: ', '') || 'None selected'},
                                        ...(minSamplesLeaf1Input && minSamplesLeaf2Input ? [
                                            {type: 'range', label1: 'Min Samples Leaf (Min)', value1: minSamplesLeaf1Input.toString(), label2: 'Min Samples Leaf (Max)', value2: minSamplesLeaf2Input.toString()}
                                        ] : [{label: 'Min Samples Leaf Range', value: 'Not defined'}]),
                                        ...(minSamplesSplit1Input && minSamplesSplit2Input ? [
                                            {type: 'range', label1: 'Min Samples Split (Min)', value1: minSamplesSplit1Input.toString(), label2: 'Min Samples Split (Max)', value2: minSamplesSplit2Input.toString()}
                                        ] : [{label: 'Minimum Samples Split Range', value: 'Not defined'}])
                                    );
                                }

                                // Popula o modal com os parâmetros
                                const parametersDisplay = document.getElementById('parametersDisplay');
                                parametersDisplay.innerHTML = '';

                                parametersArray.forEach(param => {
                                    const paramItem = document.createElement('div');

                                    if (param.type === 'range') {
                                        // Para itens de range, cria layout especial
                                        paramItem.className = 'param-item range-item';
                                        paramItem.innerHTML = `
                        <div class="range-pair">
                            <span class="param-label">${param.label1}:</span>
                            <span class="param-value">${param.value1}</span>
                        </div>
                        <span class="range-separator">|</span>
                        <div class="range-pair">
                            <span class="param-label">${param.label2}:</span>
                            <span class="param-value">${param.value2}</span>
                        </div>
                    `;
                                    } else {
                                        // Para itens normais
                                        paramItem.className = 'param-item';

                                        const isEmpty = param.value.includes('Not') || param.value.includes('None');
                                        const valueClass = isEmpty ? 'param-value empty-param' : 'param-value';

                                        paramItem.innerHTML = `
                        <span class="param-label">${param.label}:</span>
                        <span class="${valueClass}">${param.value}</span>
                    `;
                                    }

                                    parametersDisplay.appendChild(paramItem);
                                });

                                // Mostra o modal
                                document.getElementById('confirmationModal').style.display = 'block';
                            });

                            // Função para executar o treinamento
                            function executeTraining() {
                                if (!currentConfig) return;

                                // Atualizar o conteúdo da div step_result com loading
                                updateResultsStep('<div class="loading">Training model...</div>');

                                fetch('/trainGridModel', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    },
                                    body: JSON.stringify(currentConfig),
                                })
                                    .then(response => response.json())
                                    .then(data => {
                                        console.log("Best Params:", data.best_params);
                                        console.log("Best Value:", data.best_value);
                                        console.log("Classification Report:", data.classification_report);

                                        // Exibir resultados na página
                                        displayResults(data);
                                    })
                                    .catch(error => {
                                        console.error('Erro ao executar o script:', error);
                                        updateResultsStep('<div style="text-align: center; color: #e74c3c; padding: 40px;">Error loading results. Please try again.</div>');
                                    });
                            }

                            // Função para atualizar o conteúdo da div step_result
                            function updateResultsStep(content) {
                                const stepResult = document.getElementById('step_result');
                                const contentWrapper = stepResult.querySelector('.content-wrapper');

                                // Manter o botão de voltar
                                const backButton = contentWrapper.querySelector('#backToTrainingBtn');

                                contentWrapper.innerHTML = content;

                                // Re-adicionar o botão de voltar
                                if (backButton) {
                                    contentWrapper.appendChild(backButton);
                                }
                            }

                            // Função para exibir os resultados
                            function displayResults(data) {
                                const resultsHTML = `
        <div class="results-grid" style="display: flex; flex-direction: row; justify-content: center; align-items: flex-start !important;">
            <!-- Best Parameters and Score -->
            <div class="result-section">
                <div class="section-title">Best Parameters</div>
                <div class="best-params-grid">
                    ${generateParamsHTML(data.best_params)}
                </div>
            </div>
            
            <!-- Classification Report -->
            <div class="result-section classification-report">
                <div class="section-title">Classification Report</div>
                ${generateClassificationReportHTML(data.classification_report)}
            </div>
        </div>
    `;

                                updateResultsStep(resultsHTML);
                            }

                            // Função para gerar HTML dos parâmetros
                            function generateParamsHTML(params) {
                                return Object.entries(params).map(([key, value]) => {
                                    let displayValue = value;

                                    // Formatação especial para diferentes tipos de valores
                                    if (Array.isArray(value)) {
                                        displayValue = `[${value.join(', ')}]`;
                                    } else if (typeof value === 'number') {
                                        if (key === 'mlp__alpha' || key === 'mlp__learning_rate_init') {
                                            displayValue = value.toFixed(6);
                                        }
                                    } else {
                                        displayValue = String(value);
                                    }

                                    return `
            <div class="parameter-item">
                <div class="parameter-label">${formatParameterName(key)}</div>
                <div class="parameter-value">${displayValue}</div>
            </div>
        `;
                                }).join('');
                            }

                            function formatParameterName(paramName) {
                                return paramName
                                    .replace(/^(mlp__|kbest__|rf__)/, '')
                                    .replace(/_/g, ' ')
                                    .replace(/([A-Z])/g, ' $1')
                                    .replace(/\b\w/g, l => l.toUpperCase())
                                    .trim();
                            }

                            // Função para gerar HTML do relatório de classificação
                            function generateClassificationReportHTML(report) {
                                const classRows = [];
                                const generalRows = [];

                                // Separar classes das métricas gerais
                                const classes = [];
                                const metrics = ['micro avg', 'macro avg', 'weighted avg', 'accuracy'];
                                const generalMetrics = [];

                                for (const [key, value] of Object.entries(report)) {
                                    if (!metrics.includes(key) && typeof value === 'object' && value !== null) {
                                        classes.push([key, value]);
                                    } else if (metrics.includes(key)) {
                                        generalMetrics.push([key, value]);
                                    }
                                }

                                // Gerar linhas das classes
                                classes.forEach(([className, metrics]) => {
                                    classRows.push(`
            <tr class="class-row">
                <td class="class-name">${formatClassName(className)}</td>
                <td class="metric-value">${(metrics.precision * 100).toFixed(2)}%</td>
                <td class="metric-value">${(metrics.recall * 100).toFixed(2)}%</td>
                <td class="metric-value">${(metrics['f1-score'] * 100).toFixed(2)}%</td>
                <td class="metric-value">${metrics.support}</td>
            </tr>
        `);
                                });

                                generalMetrics.forEach(([metricName, value]) => {
                                    const rowClass = metricName === 'accuracy' ? 'accuracy-row' : 'avg-row';

                                    if (metricName === 'accuracy') {
                                        const accuracyValue = (value * 100).toFixed(2);
                                        generalRows.push(`
                <tr class="${rowClass}">
                    <td class="general-metric-name">${formatClassName(metricName)}</td>
                    <td class="metric-value">-</td>
                    <td class="metric-value">-</td>
                    <td class="metric-value">${accuracyValue}%</td>
                    <td class="metric-value">-</td>
                </tr>
            `);
                                    } else {
                                        // Para métricas avg, extrair os valores corretos do objeto
                                        const precision = typeof value === 'object' && value.precision ?
                                            (value.precision * 100).toFixed(2) + '%' : '-';
                                        const recall = typeof value === 'object' && value.recall ?
                                            (value.recall * 100).toFixed(2) + '%' : '-';
                                        const f1Score = typeof value === 'object' && value['f1-score'] ?
                                            (value['f1-score'] * 100).toFixed(2) + '%' : '-';
                                        const support = typeof value === 'object' && value.support ?
                                            value.support : '-';

                                        generalRows.push(`
                <tr class="${rowClass}">
                    <td class="general-metric-name">${formatClassName(metricName)}</td>
                    <td class="metric-value">${precision}</td>
                    <td class="metric-value">${recall}</td>
                    <td class="metric-value">${f1Score}</td>
                    <td class="metric-value">${support}</td>
                </tr>
            `);
                                    }
                                });

                                return `
        <table class="report-table">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>Precision</th>
                    <th>Recall</th>
                    <th>F1-Score</th>
                    <th>Support</th>
                </tr>
            </thead>
            <tbody>
                ${classRows.join('')}
                ${generalRows.length > 0 ? '<tr class="separator-row"><td colspan="5"></td></tr>' : ''}
                ${generalRows.join('')}
            </tbody>
        </table>
    `;
                            }

                            // Função para formatar nomes de classes
                            function formatClassName(className) {
                                return className
                                    .replace(/_/g, ' ')
                                    .replace(/([A-Z])/g, ' $1')
                                    .replace(/\b\w/g, l => l.toUpperCase())
                                    .trim();
                            }

                            // Event listeners para o modal
                            document.getElementById('confirmBtn').addEventListener('click', () => {
                                document.getElementById('confirmationModal').style.display = 'none';
                                const training_step = document.getElementById('step11')
                                const step_training = document.getElementById('step_training')

                                training_step.classList.remove('active');

                                step_training.classList.remove('disabled');
                                step_training.classList.add('active');
                                updateNavigation();
                                executeTraining();
                            });

                            document.getElementById('cancelBtn').addEventListener('click', () => {
                                document.getElementById('confirmationModal').style.display = 'none';
                                currentConfig = null;
                            });

                            document.getElementById('closeModal').addEventListener('click', () => {
                                document.getElementById('confirmationModal').style.display = 'none';
                                currentConfig = null;
                            });

                            // Fecha o modal quando clica fora dele
                            window.addEventListener('click', (event) => {
                                const modal = document.getElementById('confirmationModal');
                                if (event.target === modal) {
                                    modal.style.display = 'none';
                                    currentConfig = null;
                                }
                            });
                        </script>
                    </div>
                </div>
            </div>
            <div class="step disabled" id="step_training" data-step="step_training" data-group="TrainigOutput">
                <div class="step-title">Model Training</div>
                <div class="step-content">
                    <div class="content-wrapper"
                        style="display: flex; flex-direction: row; justify-content: space-evenly; align-items: unset;">
                        <div class="progress-section">
                            <div class="progress-info">
                                <div class="progress-label">
                                    <span class="status-indicator disconnected" id="connectionStatus"></span>
                                    Training Status
                                </div>
                                <div class="progress-stats">
                                    <div class="stat-item">
                                        <span class="stat-value" id="currentTrial">0</span>
                                        <div class="stat-label">Current Trial</div>
                                    </div>
                                    <div class="stat-item">
                                        <span class="stat-value" id="totalTrials">0</span>
                                        <div class="stat-label">Total Trials</div>
                                    </div>
                                    <div class="stat-item">
                                        <span class="stat-value" id="bestScore">-</span>
                                        <div class="stat-label">Best Score</div>
                                    </div>
                                </div>
                            </div>

                            <div class="progress-wrapper">
                                <div class="progress-percentage" id="progressPercentage">0%</div>
                                <progress class="progress-bar" id="progressBar" value="0"></progress>
                            </div>
                            <div class="chart-section" id="chartSection"
                                style="margin-top: 20px; padding: 20px; background: #f8f9fa; border-radius: 8px; display: none;">
                                <h4 style="margin-bottom: 15px; color: #333;">MLP Training Loss</h4>
                                <canvas id="lossChart" width="400" height="200"></canvas>
                            </div>
                        </div>
                        <div class="log-wrapper">
                            <div class="log-section">
                                <div class="log-header" id="logHeader">
                                    <h4 class="log-title">Training Log</h4>
                                    <span class="log-toggle" id="logToggle">▼</span>
                                </div>
                                <div class="log-content" id="logContent">
                                </div>
                            </div>
                            <div id="viewResultsContainer" style="margin-top: 20px; text-align: center; display: none;">
                                <button id="viewResultsBtn" type="button">View Results</button>
                            </div>
                        </div>
                    </div>
                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                    <script>
                        class ProgressTracker {
                            constructor() {
                                this.socket = null;
                                this.totalTrials = 0;
                                this.currentTrial = 0;
                                this.bestScore = 0;
                                this.lossData = [];
                                this.lossChart = null;
                                this.logCollapsed = false;
                                this.chartVisible = false;
                                this.downsampleInterval = 1;

                                this.initializeElements();
                                this.initializeWebSocket();
                                this.initializeLossChart();
                                this.initializeLog();
                                this.initializeButtons();
                            }

                            initializeElements() {
                                this.progressBar = document.getElementById('progressBar');
                                this.connectionStatus = document.getElementById('connectionStatus');
                                this.currentTrialEl = document.getElementById('currentTrial');
                                this.totalTrialsEl = document.getElementById('totalTrials');
                                this.bestScoreEl = document.getElementById('bestScore');
                                this.progressPercentage = document.getElementById('progressPercentage');
                                this.logContent = document.getElementById('logContent');
                                this.logHeader = document.getElementById('logHeader');
                                this.logToggle = document.getElementById('logToggle');
                                this.chartSection = document.getElementById('chartSection');
                                this.viewResultsContainer = document.getElementById('viewResultsContainer');
                                this.viewResultsBtn = document.getElementById('viewResultsBtn');
                            }

                            initializeWebSocket() {
                                this.socket = new WebSocket('ws://localhost:3001');
                                this.socket.onopen = () => {
                                    this.updateConnectionStatus(true);
                                    this.totalTrials = parseInt(document.getElementById('nTrials').value);
                                    this.progressBar.max = this.totalTrials;
                                    this.totalTrialsEl.textContent = this.totalTrials;
                                };

                                this.socket.onmessage = (event) => {
                                    this.handleMessage(event);
                                };

                                this.socket.onclose = () => {
                                    this.updateConnectionStatus(false);
                                };

                                this.socket.onerror = () => {
                                    this.updateConnectionStatus(false);
                                };
                            }

                            initializeLossChart() {
                                const ctx = document.getElementById('lossChart').getContext('2d');
                                this.lossChart = new Chart(ctx, {
                                    type: 'line',
                                    data: {
                                        labels: [],
                                        datasets: [{
                                            label: 'Training Loss',
                                            data: [],
                                            borderColor: 'rgb(75, 192, 192)',
                                            backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                            tension: 0.1,
                                            pointRadius: 0
                                        }]
                                    },
                                    options: {
                                        responsive: true,
                                        scales: {
                                            y: {
                                                beginAtZero: false,
                                                title: {
                                                    display: true,
                                                    text: 'Loss'
                                                }
                                            },
                                            x: {
                                                title: {
                                                    display: true,
                                                    text: 'Iteration'
                                                }
                                            }
                                        },
                                        plugins: {
                                            title: {
                                                display: false,
                                            }
                                        },
                                        animation: {
                                            duration: 0
                                        }
                                    }
                                });
                            }

                            initializeLog() {
                                this.logHeader.addEventListener('click', () => {
                                    this.toggleLog();
                                });
                            }

                            initializeButtons() {
                                this.viewResultsBtn.addEventListener('click', () => {
                                    this.goToResults();
                                });
                            }

                            goToResults() {
                                const step_result = document.getElementById('step_result');
                                const step_training = document.getElementById('step_training');

                                step_result.classList.remove('disabled');
                                step_result.classList.add('active');

                                step_training.classList.remove('active');
                                step_training.classList.add('disabled');
                            }

                            goToTraining() {
                                const step_result = document.getElementById('step_result');
                                const step_training = document.getElementById('step_training');

                                step_training.classList.remove('disabled');
                                step_training.classList.add('active');

                                step_result.classList.remove('active');
                                step_result.classList.add('disabled');
                            }

                            handleMessage(event) {
                                try {
                                    const data = JSON.parse(event.data);
                                    if (data.type === 'progress') {
                                        this.processProgressMessage(data.message);
                                    } else if (data.type === 'training') {
                                        this.processMlpTrainingMessage(data.message);
                                    }
                                } catch (error) {
                                    console.error('Erro ao processar mensagem:', error);
                                }
                            }

                            processProgressMessage(message) {
                                const trialMatch = message.match(/Trial (\d+) finished/);
                                const bestMatch = message.match(/Best is trial \d+ with value: ([\d.]+)/);

                                if (trialMatch) {
                                    this.currentTrial = parseInt(trialMatch[1]) + 1;
                                    this.updateProgress();
                                }

                                if (bestMatch) {
                                    this.bestScore = parseFloat(bestMatch[1]);
                                    this.bestScoreEl.textContent = this.bestScore.toFixed(4);
                                    this.addLogEntry('trial', message);
                                }
                            }

                            processMlpTrainingMessage(message) {
                                const iterationMatch = message.match(/Iteration (\d+), Loss: ([\d.]+)/);
                                const doneMatch = message.match("Training completed!")

                                if (iterationMatch) {
                                    const iteration = parseInt(iterationMatch[1]);
                                    const loss = parseFloat(iterationMatch[2]);

                                    // Mostra o gráfico na primeira vez que recebe dados de loss
                                    if (!this.chartVisible) {
                                        this.chartSection.style.display = 'block';
                                        this.chartVisible = true;
                                    }

                                    this.lossData.push({iteration, loss});

                                    // Atualiza o intervalo de downsampling baseado na quantidade de dados
                                    this.updateDownsampleInterval();

                                    // Reconstrói os dados do gráfico com downsampling
                                    this.updateChartData();

                                    this.addLogEntry('loss', message);
                                }

                                if (doneMatch) {
                                    this.addLogEntry('done', message);
                                    this.viewResultsContainer.style.display = 'block';
                                }
                            }

                            updateDownsampleInterval() {
                                const dataLength = this.lossData.length;
                                // Ajusta o intervalo para manter aproximadamente 200-300 pontos no gráfico
                                if (dataLength > 1000) {
                                    this.downsampleInterval = Math.floor(dataLength / 200);
                                } else if (dataLength > 500) {
                                    this.downsampleInterval = Math.floor(dataLength / 250);
                                } else {
                                    this.downsampleInterval = 1;
                                }
                            }

                            updateChartData() {
                                // Limpa os dados atuais
                                this.lossChart.data.labels = [];
                                this.lossChart.data.datasets[0].data = [];

                                // Adiciona dados com downsampling
                                for (let i = 0; i < this.lossData.length; i += this.downsampleInterval) {
                                    const dataPoint = this.lossData[i];
                                    this.lossChart.data.labels.push(dataPoint.iteration);
                                    this.lossChart.data.datasets[0].data.push(dataPoint.loss);
                                }

                                // Sempre inclui o último ponto para mostrar o estado atual
                                if (this.lossData.length > 0 && this.downsampleInterval > 1) {
                                    const lastPoint = this.lossData[this.lossData.length - 1];
                                    const lastLabel = this.lossChart.data.labels[this.lossChart.data.labels.length - 1];

                                    if (lastPoint.iteration !== lastLabel) {
                                        this.lossChart.data.labels.push(lastPoint.iteration);
                                        this.lossChart.data.datasets[0].data.push(lastPoint.loss);
                                    }
                                }

                                this.lossChart.update('none');
                            }

                            addLogEntry(type, message) {
                                const logEntry = document.createElement('div');
                                logEntry.className = `log-entry ${type}`;

                                const timestamp = new Date().toLocaleTimeString();
                                logEntry.textContent = `[${timestamp}] ${message}`;

                                this.logContent.appendChild(logEntry);

                                // Auto scroll no log se não estiver colapsado
                                if (!this.logCollapsed) {
                                    this.logContent.scrollTop = this.logContent.scrollHeight;
                                }
                            }

                            toggleLog() {
                                this.logCollapsed = !this.logCollapsed;
                                this.logContent.classList.toggle('collapsed', this.logCollapsed);
                                this.logToggle.classList.toggle('collapsed', this.logCollapsed);
                            }

                            updateProgress() {
                                this.progressBar.value = this.currentTrial;
                                this.currentTrialEl.textContent = this.currentTrial;

                                const percentage = Math.round((this.currentTrial / this.totalTrials) * 100);
                                this.progressPercentage.textContent = `${percentage}%`;
                            }

                            updateConnectionStatus(connected) {
                                this.connectionStatus.className = `status-indicator ${connected ? 'connected' : 'disconnected'}`;
                            }

                            updateTotalTrials() {
                                this.totalTrials = parseInt(document.getElementById('nTrials').value);
                                this.progressBar.max = this.totalTrials;
                                this.totalTrialsEl.textContent = this.totalTrials;
                            }
                        }

                        // Inicializa o tracker quando a página carrega
                        document.addEventListener('DOMContentLoaded', () => {
                            const progressTracker = new ProgressTracker();

                            // Adiciona listener para atualizar quando nTrials mudar
                            const nTrialsInput = document.getElementById('nTrials');
                            nTrialsInput.addEventListener('input', () => {
                                if (progressTracker.socket && progressTracker.socket.readyState === WebSocket.OPEN) {
                                    progressTracker.updateTotalTrials();
                                }
                            });

                            // Torna o progressTracker globalmente acessível
                            window.progressTracker = progressTracker;
                        });
                    </script>
                </div>
            </div>
            <div class="step disabled" id="step_result" data-step="step_result" data-group="ModelResults">
                <div class="step-title">Model Results</div>
                <div class="step-content">
                    <div class="content-wrapper" style="display: block">
                        <div style="margin-bottom: 20px;">
                            <button id="backToTrainingBtn" type="button">Back to Training</button>
                        </div>
                    </div>
                </div>
            </div>
            <script>
                // Adiciona listener para o botão de voltar ao treinamento
                document.addEventListener('DOMContentLoaded', () => {
                    const backBtn = document.getElementById('backToTrainingBtn');
                    backBtn.addEventListener('click', () => {
                        if (window.progressTracker) {
                            window.progressTracker.goToTraining();
                        }
                    });
                });
            </script>
            <div id="navigation_content">
                <div class="navigation buttons">
                    <button type="button" id="prevBtn" onclick="prevStep()" disabled>Previous</button>
                    <span class="dots" id="dots-container">
                    </span>
                    <button type="button" id="nextBtn" onclick="nextStep()">Next</button>
                </div>
            </div>
        </form>
    </div>
    <div class="footer">
        School of Arts, Sciences and Humanities - University of São Paulo
    </div>
    <script>
        let currentStep = 0;

        function handleModelSelection() {
            const mlp = document.getElementById("MLP").checked;
            const randomForest = document.getElementById("RandomForest").checked;

            const mlpSteps = document.querySelectorAll('[data-group="MLP"]');
            mlpSteps.forEach(step => {
                if (mlp) {
                    step.classList.remove('disabled');
                } else {
                    step.classList.add('disabled');
                }
            });

            const randomForestSteps = document.querySelectorAll('[data-group="RandomForest"]');
            randomForestSteps.forEach(step => {
                if (randomForest) {
                    step.classList.remove('disabled');
                } else {
                    step.classList.add('disabled');
                }
            });

            updateNavigation();

            if (getCurrentStep().classList.contains('disabled')) {
                currentStep = 3;
                showStep(currentStep);
            } else {

                updateContainerStyle();
            }
        }

        function getEnabledSteps() {
            return document.querySelectorAll('.step:not(.disabled)');
        }

        function getCurrentStep() {
            const enabledSteps = getEnabledSteps();
            return enabledSteps[currentStep];
        }

        function updateNavigation() {
            const dotsContainer = document.getElementById('dots-container');
            const enabledSteps = getEnabledSteps();
            const step_training = document.getElementById('step_training');
            const step_result = document.getElementById('step_result')
            const navigation = document.getElementById('navigation_content');

            if (step_training.classList.contains('active') || step_result.classList.contains('active')) {
                navigation.style.display = 'none';
            }

            dotsContainer.innerHTML = '';
            enabledSteps.forEach((step, index) => {
                const dot = document.createElement('span');
                dot.className = 'dot';
                if (index === currentStep) dot.classList.add('active-dot');
                dot.onclick = () => goToStep(index + 1);
                dotsContainer.appendChild(dot);
            });

        }

        function updateContainerStyle() {
            const container = document.getElementById("container-geral");
            const enabledSteps = getEnabledSteps();

            if (enabledSteps.length === 0) return;

            const currentStepElement = enabledSteps[currentStep];
            const currentGroup = currentStepElement.getAttribute('data-group');

            container.classList.remove('group-blue', 'group-orange');

            const groupOrder = [];
            enabledSteps.forEach(step => {
                const group = step.getAttribute('data-group');
                if (!groupOrder.includes(group)) {
                    groupOrder.push(group);
                }
            });

            const groupIndex = groupOrder.indexOf(currentGroup);

            const colorClass = (groupIndex % 2 === 0) ? 'group-blue' : 'group-orange';
            container.classList.add(colorClass);
        }

        function showStep(stepIndex) {
            const enabledSteps = getEnabledSteps();

            document.querySelectorAll('.step').forEach(step => {
                step.classList.remove('active');
            });

            if (enabledSteps[stepIndex]) {
                enabledSteps[stepIndex].classList.add('active');
            }

            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");

            prevBtn.disabled = (stepIndex === 0);
            nextBtn.disabled = (stepIndex === enabledSteps.length - 1);

            const dots = document.querySelectorAll(".dot");
            dots.forEach((dot, index) => {
                dot.classList.toggle("active-dot", index === stepIndex);
            });

            updateContainerStyle();
        }

        function nextStep() {
            if (validateStep(currentStep)) {
                const enabledSteps = getEnabledSteps();
                if (currentStep < enabledSteps.length - 1) {
                    currentStep++;
                    showStep(currentStep);
                }
            }
        }

        function prevStep() {
            if (currentStep > 0) {
                currentStep--;
                showStep(currentStep);
            }
        }

        function goToStep(step) {
            const stepIndex = step - 1;
            const enabledSteps = getEnabledSteps();
            if (stepIndex >= 0 && stepIndex < enabledSteps.length && validateStep(currentStep)) {
                currentStep = stepIndex;
                showStep(currentStep);
            }
        }

        function validateStep(stepIndex) {
            const enabledSteps = getEnabledSteps();
            const currentStepElement = enabledSteps[stepIndex];
            const stepNumber = parseInt(currentStepElement.getAttribute('data-step'));

            if (stepNumber == 2) {
                const errorMessageStep2 = document.getElementById('error-message-step2');
                const datasetName = document.getElementById('datasetFileName');
                if (datasetName == "No dataset selected") {
                    errorMessageStep2.innerText = "Select your dataset.";
                    return false
                } else {
                    errorMessageStep2.innerText = "";
                    return true
                }
            } else if (stepNumber == 3) {
                const errorMessageStep3 = document.getElementById('error-message-step3');
                if (document.querySelectorAll('#checkbox-list-target input[type="checkbox"]:checked').length === 0) {
                    errorMessageStep3.innerText = "Select your model's target feature";
                    return false
                } else {
                    errorMessageStep3.innerText = "";
                    return true
                }
            } else if (stepNumber === 4) {
                const errorMessageK = document.getElementById('error-message-k');
                const errorMessageSF = document.getElementById('error-message-SF');
                const errorMessageFS = document.getElementById('error-message-FS');
                validateKInputs();
                validateSF();
                validateFS();

                if (errorMessageK.innerText !== "" || errorMessageFS.innerText !== "" || errorMessageSF.innerText !== "") {
                    return false;
                } else {
                    return true;
                }
            } else if (stepNumber == 5) {
                const errorMessageStep5 = document.getElementById('error-message-5');
                const mpl = document.getElementById('MLP').checked;
                const randomForest = document.getElementById('RandomForest').checked;

                if (!mpl && !randomForest) {
                    errorMessageStep5.innerText = "Select your desired model";
                    return false;
                }
                else {
                    errorMessageStep5.innerText = "";
                    return true
                }
            } else if (stepNumber === 6) {
                const errorMessageAF = document.getElementById('error-message-AF');
                const errorMessageAlpha = document.getElementById('error-message-alpha');
                const errorMessageEpoch = document.getElementById('error-message-epoch');

                validateAF();
                validateAlphaInputs();
                validateEpochInputs();
                if (errorMessageAF.innerText !== "" || errorMessageAlpha.innerText !== "" || errorMessageEpoch.innerText !== "") {
                    return false;
                } else {
                    return true;
                }
            } else if (stepNumber === 7) {
                const errorMessageSolver = document.getElementById('error-message-solver');
                const errorMessageLR = document.getElementById('error-message-lr');
                const errorMessageILR = document.getElementById('error-message-ilr');

                validateSolver();
                validateLR();
                validateLRInputs();
                if (errorMessageSolver.innerText !== "" || errorMessageLR.innerText !== "" || errorMessageILR.innerText !== "") {
                    return false;
                } else {
                    return true;
                }
            } else if (stepNumber === 8) {
                const errorMessageHL = document.getElementById('error-message-hl');
                validateAllHiddenLayerConfigs();
                if (errorMessageHL.innerText !== "") {
                    return false;
                } else {
                    return true;
                }
            } else if (stepNumber === 9) {
                const errorMessageNEstimators = document.getElementById('error-message-nEstimators');
                const errorMessageDepth = document.getElementById('error-message-depth')
                const errorMessageMF = document.getElementById('error-message-MF')

                validateNEstimators();
                validateDepthInputs();
                validateMF();
                if (errorMessageNEstimators.innerText !== "" || errorMessageDepth.innerText !== "" || errorMessageMF.innerText !== "") {
                    return false;
                } else {
                    return true;
                }
            } else if (stepNumber === 10) {
                const errorMessageCriterion = document.getElementById('error-message-criterion');
                const errorMessageMinSamplesLeaf = document.getElementById('error-message-minSamplesLeaf')
                const errorMessageMinSamplesSplit = document.getElementById('error-message-minSamplesSplit')

                validateCriterion();
                validateMinSamplesLeaf();
                validateMinSamplesSplit();
                if (errorMessageCriterion.innerText !== "" || errorMessageMinSamplesLeaf.innerText !== "" || errorMessageMinSamplesSplit.innerText !== "") {
                    return false;
                } else {
                    return true;
                }
            }
            const inputs = currentStepElement.querySelectorAll("input[required]");
            for (let input of inputs) {
                if (!input.checkValidity()) {
                    return false;
                }
            }
            return true;
        }
        showStep(currentStep);
        updateNavigation(); 
    </script>
    <script>
        document.querySelectorAll('.option-tooltip').forEach(container => {
            const icon = container.querySelector('.tooltip-icon');
            const tooltip = container.querySelector('.tooltip-text');

            icon.addEventListener('mouseenter', () => {
                const rect = icon.getBoundingClientRect();
                tooltip.classList.add('fixed-tooltip');
                tooltip.style.top = `${rect.top + window.scrollY + rect.height - 8}px`;
                tooltip.style.left = `${rect.right + rect.width - 15}px`;
                tooltip.style.visibility = 'visible';
                tooltip.style.opacity = '1';
            });

            icon.addEventListener('mouseleave', () => {
                tooltip.classList.remove('fixed-tooltip');
                tooltip.style.visibility = '';
                tooltip.style.opacity = '';
                tooltip.style.top = '';
                tooltip.style.left = '';
            });
        });
    </script>
</body>

</html>